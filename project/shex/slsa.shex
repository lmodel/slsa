# metamodel_version: 1.12.0
# version: 1.2.0
BASE <https://w3id.org/lmodel/slsa/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<InTotoAnnotation> CLOSED {
    (  $<InTotoAnnotation_tes> (  <annotation_key> @linkml:String ;
          <annotation_values> @linkml:String *
       ) ;
       rdf:type [ <InTotoAnnotation> ] ?
    )
}

<InTotoDigestSet> CLOSED {
    (  $<InTotoDigestSet_tes> (  <sha256> @linkml:String ? ;
          <sha512> @linkml:String ? ;
          <git_commit> @linkml:String ? ;
          <git_tree> @linkml:String ? ;
          <dir_hash> @linkml:String ?
       ) ;
       rdf:type [ <InTotoDigestSet> ] ?
    )
}

<InTotoResourceDescriptor> CLOSED {
    (  $<InTotoResourceDescriptor_tes> (  <resource_uri> @linkml:Uri ? ;
          <digest> @<InTotoDigestSet> ? ;
          <resource_name> @linkml:String ? ;
          <download_location> @linkml:Uri ? ;
          <media_type> @linkml:String ? ;
          <annotations> @<InTotoAnnotation> *
       ) ;
       rdf:type [ <InTotoResourceDescriptor> ] ?
    )
}

<InTotoStatement> CLOSED {
    (  $<InTotoStatement_tes> (  <statement_type> @linkml:Uri ;
          <subject> @<InTotoResourceDescriptor> + ;
          <predicate_type> @linkml:Uri ;
          <predicate> @<SlsaPredicate> ? ;
          <attestation_storage_uri> @linkml:Uri ? ;
          <signing_tool> @linkml:Uri ? ;
          <transparency_log_entry> @linkml:Uri ?
       ) ;
       rdf:type [ <InTotoStatement> ] ?
    )
}

<SlsaAdoptionMetadata> CLOSED {
    (  $<SlsaAdoptionMetadata_tes> (  <challenges> [ <https://w3id.org/lmodel/slsa/SlsaAdoptionChallenge#COMPLEX_IMPLEMENTATION>
             <https://w3id.org/lmodel/slsa/SlsaAdoptionChallenge#UNCLEAR_COMMUNICATION>
             <https://w3id.org/lmodel/slsa/SlsaAdoptionChallenge#LIMITED_FEASIBILITY>
             <https://w3id.org/lmodel/slsa/SlsaAdoptionChallenge#UNCLEAR_RELEVANCE> ] * ;
          <strategies> [ <https://w3id.org/lmodel/slsa/SlsaAdoptionStrategy#ENHANCE_ALIGNMENT_FLEXIBILITY>
             <https://w3id.org/lmodel/slsa/SlsaAdoptionStrategy#PROVIDE_DETAILED_DOCUMENTATION>
             <https://w3id.org/lmodel/slsa/SlsaAdoptionStrategy#STREAMLINE_PROVENANCE_GENERATION>
             <https://w3id.org/lmodel/slsa/SlsaAdoptionStrategy#IMPROVE_VERIFICATION_PROCESS>
             <https://w3id.org/lmodel/slsa/SlsaAdoptionStrategy#COLLABORATE_WITH_COMMUNITY> ] *
       ) ;
       rdf:type [ <SlsaAdoptionMetadata> ] ?
    )
}

<SlsaBranch> CLOSED {
    (  $<SlsaBranch_tes> (  &<SlsaNamedReference_tes> ;
          rdf:type [ <SlsaNamedReference> ] ?
       ) ;
       rdf:type [ <SlsaBranch> ] ?
    )
}

<SlsaBuildDefinition> CLOSED {
    (  $<SlsaBuildDefinition_tes> (  <build_type> @linkml:Uri ;
          <external_parameters> @<SlsaBuildParameter> * ;
          <internal_parameters> @<SlsaBuildParameter> * ;
          <resolved_dependencies> @<InTotoResourceDescriptor> * ;
          <hermetic> @linkml:Boolean ? ;
          <provenance_generation_tool> @linkml:Uri ? ;
          <pipeline_orchestrator> @linkml:Uri ?
       ) ;
       rdf:type [ <SlsaBuildDefinition> ] ?
    )
}

<SlsaBuildEnvironmentAttestation> CLOSED {
    (  $<SlsaBuildEnvironmentAttestation_tes> (  &<SlsaPredicate_tes> ;
          rdf:type [ <SlsaPredicate> ] ? ;
          <build_env_level> [ <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel#SLSA_BUILD_ENV_LEVEL_0>
             <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel#SLSA_BUILD_ENV_LEVEL_1>
             <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel#SLSA_BUILD_ENV_LEVEL_2>
             <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel#SLSA_BUILD_ENV_LEVEL_3> ] ? ;
          <build_id> @linkml:String ;
          <build_image> @<SlsaBuildImage> ? ;
          <measurements> @<SlsaMeasurement> *
       ) ;
       rdf:type [ <SlsaBuildEnvironmentAttestation> ] ?
    )
}

<SlsaBuildImage> CLOSED {
    (  $<SlsaBuildImage_tes> (  <build_env_level> [ <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel#SLSA_BUILD_ENV_LEVEL_0>
             <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel#SLSA_BUILD_ENV_LEVEL_1>
             <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel#SLSA_BUILD_ENV_LEVEL_2>
             <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel#SLSA_BUILD_ENV_LEVEL_3> ] ? ;
          <provenance> @<SlsaBuildProvenance> ? ;
          <produced_by> @<SlsaBuildImageProducer> ?
       ) ;
       rdf:type [ <SlsaBuildImage> ]
    )
}

<SlsaBuildImageProducer> CLOSED {
    (  $<SlsaBuildImageProducer_tes> (  &<SlsaParty_tes> ;
          rdf:type [ <SlsaParty> ] ?
       ) ;
       rdf:type [ <SlsaBuildImageProducer> ] ?
    )
}

<SlsaBuildMetadata> CLOSED {
    (  $<SlsaBuildMetadata_tes> (  <invocation_id> @linkml:String ? ;
          <started_on> @linkml:Datetime ? ;
          <finished_on> @linkml:Datetime ?
       ) ;
       rdf:type [ <SlsaBuildMetadata> ] ?
    )
}

<SlsaBuildParameter> CLOSED {
    (  $<SlsaBuildParameter_tes> (  <parameter_name> @linkml:String ;
          <parameter_value> @linkml:String ?
       ) ;
       rdf:type [ <SlsaBuildParameter> ] ?
    )
}

<SlsaBuildPlatform> CLOSED {
    (  $<SlsaBuildPlatform_tes> (  <component_versions> @<SlsaComponentVersion> * ;
          <build_level> [ <https://w3id.org/lmodel/slsa/SlsaBuildLevel#SLSA_BUILD_LEVEL_0>
             <https://w3id.org/lmodel/slsa/SlsaBuildLevel#SLSA_BUILD_LEVEL_1>
             <https://w3id.org/lmodel/slsa/SlsaBuildLevel#SLSA_BUILD_LEVEL_2>
             <https://w3id.org/lmodel/slsa/SlsaBuildLevel#SLSA_BUILD_LEVEL_3> ] ? ;
          <hosted> @linkml:Boolean ? ;
          <builder_dependencies> @<InTotoResourceDescriptor> *
       ) ;
       rdf:type [ <SlsaBuildPlatform> ]
    )
}

<SlsaBuildProvenance> CLOSED {
    (  $<SlsaBuildProvenance_tes> (  &<SlsaPredicate_tes> ;
          rdf:type [ <SlsaPredicate> ] ? ;
          <build_definition> @<SlsaBuildDefinition> ;
          <run_details> @<SlsaRunDetails>
       ) ;
       rdf:type [ <SlsaBuildProvenance> ] ?
    )
}

<SlsaComponentVersion> CLOSED {
    (  $<SlsaComponentVersion_tes> (  <component> @linkml:String ;
          <component_version> @linkml:String ?
       ) ;
       rdf:type [ <SlsaComponentVersion> ] ?
    )
}

<SlsaConsumer> CLOSED {
    (  $<SlsaConsumer_tes> (  &<SlsaParty_tes> ;
          rdf:type [ <SlsaParty> ] ?
       ) ;
       rdf:type [ <SlsaConsumer> ] ?
    )
}

<SlsaControlPlane> CLOSED {
    (  $<SlsaControlPlane_tes> <build_platform> @<SlsaBuildPlatform> ? ;
       rdf:type [ <SlsaControlPlane> ] ?
    )
}

<SlsaDependencyInventory> CLOSED {
    (  $<SlsaDependencyInventory_tes> (  <artifact> @<InTotoResourceDescriptor> ;
          <dependencies> @<InTotoResourceDescriptor> * ;
          <dependency_level> [ <https://w3id.org/lmodel/slsa/SlsaDependencyLevel#SLSA_DEPENDENCY_LEVEL_0>
             <https://w3id.org/lmodel/slsa/SlsaDependencyLevel#SLSA_DEPENDENCY_LEVEL_1>
             <https://w3id.org/lmodel/slsa/SlsaDependencyLevel#SLSA_DEPENDENCY_LEVEL_2>
             <https://w3id.org/lmodel/slsa/SlsaDependencyLevel#SLSA_DEPENDENCY_LEVEL_3>
             <https://w3id.org/lmodel/slsa/SlsaDependencyLevel#SLSA_DEPENDENCY_LEVEL_4> ] ?
       ) ;
       rdf:type [ <SlsaDependencyInventory> ] ?
    )
}

<SlsaDependencyLevelCount> CLOSED {
    (  $<SlsaDependencyLevelCount_tes> (  <verified_level> [ <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_UNEVALUATED>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_0>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_1>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_2>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_3>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_UNEVALUATED>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_0>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_1>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_2>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_3>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_4>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_TWO_PARTY_REVIEWED>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_REPRODUCED> <https://w3id.org/lmodel/slsa/SlsaResult#FAILED> ] ;
          <dependency_count> @linkml:Integer
       ) ;
       rdf:type [ <SlsaDependencyLevelCount> ] ?
    )
}

<SlsaDocument> CLOSED {
    (  $<SlsaDocument_tes> (  <attestations> @<InTotoStatement> * ;
          <parties> @<SlsaParty> * ;
          <build_platforms> @<SlsaBuildPlatform> * ;
          <packages> @<SlsaPackage> * ;
          <package_registries> @<SlsaPackageRegistry> * ;
          <source_control_systems> @<SlsaSourceControlSystem> * ;
          <source_repositories> @<SlsaSourceRepository> * ;
          <source_revisions> @<SlsaSourceRevision> * ;
          <named_references> @<SlsaNamedReference> * ;
          <build_images> @<SlsaBuildImage> * ;
          <dependency_inventories> @<SlsaDependencyInventory> * ;
          <adoption_metadata> @<SlsaAdoptionMetadata> ?
       ) ;
       rdf:type [ <SlsaDocument> ] ?
    )
}

<SlsaInfrastructureProvider> CLOSED {
    (  $<SlsaInfrastructureProvider_tes> (  &<SlsaParty_tes> ;
          rdf:type [ <SlsaParty> ] ?
       ) ;
       rdf:type [ <SlsaInfrastructureProvider> ] ?
    )
}

<SlsaMeasurement> CLOSED {
    (  $<SlsaMeasurement_tes> (  <digest> @<InTotoDigestSet> ? ;
          <measured_component> @linkml:String
       ) ;
       rdf:type [ <SlsaMeasurement> ] ?
    )
}

<SlsaNamedReference>  (
    CLOSED {
       (  $<SlsaNamedReference_tes> (  <repository> @<SlsaSourceRepository> ? ;
             <revision> @<SlsaSourceRevision> ? ;
             <reference_type> @linkml:String ? ;
             <reference_name> @linkml:String ;
             <protected> @linkml:Boolean ?
          ) ;
          rdf:type [ <SlsaNamedReference> ] ?
       )
    } OR @<SlsaBranch> OR @<SlsaTag>
)

<SlsaPackage> CLOSED {
    (  $<SlsaPackage_tes> (  <ecosystem> @linkml:String ? ;
          <package_name> @linkml:String ;
          <registry> @<SlsaPackageRegistry> ? ;
          <package_artifacts> @<InTotoResourceDescriptor> * ;
          <guac_uri> @linkml:Uri ? ;
          <security_insights_uri> @linkml:Uri ?
       ) ;
       rdf:type [ <SlsaPackage> ] ?
    )
}

<SlsaPackageRegistry> CLOSED {
    (  $<SlsaPackageRegistry_tes> <ecosystem> @linkml:String ? ;
       rdf:type [ <SlsaPackageRegistry> ]
    )
}

<SlsaParty>  (
    @<SlsaBuildImageProducer> OR @<SlsaConsumer> OR @<SlsaInfrastructureProvider> OR @<SlsaProducer> OR @<SlsaVerifier>
)

<SlsaParty_struct> {
    (  $<SlsaParty_tes> (  <party_type> @linkml:String ? ;
          <party_name> @linkml:String ?
       ) ;
       rdf:type [ <SlsaParty> ] ?
    )
}

<SlsaPredicate>  (
    @<SlsaBuildEnvironmentAttestation> OR @<SlsaBuildProvenance> OR @<SlsaSourceProvenance> OR @<SlsaVerificationSummary>
)

<SlsaPredicate_struct> {
    (  $<SlsaPredicate_tes> <predicate_kind> @linkml:String ? ;
       rdf:type [ <SlsaPredicate> ] ?
    )
}

<SlsaProducer> CLOSED {
    (  $<SlsaProducer_tes> (  &<SlsaParty_tes> ;
          rdf:type [ <SlsaParty> ] ? ;
          <build_platform> @<SlsaBuildPlatform> ?
       ) ;
       rdf:type [ <SlsaProducer> ] ?
    )
}

<SlsaRunDetails> CLOSED {
    (  $<SlsaRunDetails_tes> (  <builder> @<SlsaBuildPlatform> ;
          <build_metadata> @<SlsaBuildMetadata> ? ;
          <byproducts> @<InTotoResourceDescriptor> *
       ) ;
       rdf:type [ <SlsaRunDetails> ] ?
    )
}

<SlsaSourceControlSystem> CLOSED {
    (  $<SlsaSourceControlSystem_tes> rdf:type . * ;
       rdf:type [ <SlsaSourceControlSystem> ]
    )
}

<SlsaSourceProvenance> CLOSED {
    (  $<SlsaSourceProvenance_tes> (  &<SlsaPredicate_tes> ;
          rdf:type [ <SlsaPredicate> ] ? ;
          <revision> @<SlsaSourceRevision> ;
          <controls_enforced> @linkml:String *
       ) ;
       rdf:type [ <SlsaSourceProvenance> ] ?
    )
}

<SlsaSourceRepository> CLOSED {
    (  $<SlsaSourceRepository_tes> <hosted_by> @<SlsaSourceControlSystem> ? ;
       rdf:type [ <SlsaSourceRepository> ]
    )
}

<SlsaSourceRevision> CLOSED {
    (  $<SlsaSourceRevision_tes> (  <repository> @<SlsaSourceRepository> ? ;
          <authored_by> @linkml:String ? ;
          <authored_at> @linkml:Datetime ? ;
          <parent_revisions> @<SlsaSourceRevision> * ;
          <source_level> [ <https://w3id.org/lmodel/slsa/SlsaSourceLevel#SLSA_SOURCE_LEVEL_0>
             <https://w3id.org/lmodel/slsa/SlsaSourceLevel#SLSA_SOURCE_LEVEL_1>
             <https://w3id.org/lmodel/slsa/SlsaSourceLevel#SLSA_SOURCE_LEVEL_2>
             <https://w3id.org/lmodel/slsa/SlsaSourceLevel#SLSA_SOURCE_LEVEL_3>
             <https://w3id.org/lmodel/slsa/SlsaSourceLevel#SLSA_SOURCE_LEVEL_4> ] ? ;
          <review_type> [ <https://w3id.org/lmodel/slsa/SlsaReviewType#TWO_PARTY>
             <https://w3id.org/lmodel/slsa/SlsaReviewType#PAIR_PROGRAMMING>
             <https://w3id.org/lmodel/slsa/SlsaReviewType#MOB_PROGRAMMING> <https://w3id.org/lmodel/slsa/SlsaReviewType#AUTOMATED>
             ] ?
       ) ;
       rdf:type [ <SlsaSourceRevision> ]
    )
}

<SlsaTag> CLOSED {
    (  $<SlsaTag_tes> (  &<SlsaNamedReference_tes> ;
          rdf:type [ <SlsaNamedReference> ] ?
       ) ;
       rdf:type [ <SlsaTag> ] ?
    )
}

<SlsaVerificationSummary> CLOSED {
    (  $<SlsaVerificationSummary_tes> (  &<SlsaPredicate_tes> ;
          rdf:type [ <SlsaPredicate> ] ? ;
          <resource_uri> @linkml:Uri ;
          <verifier> @<SlsaVerifier> ;
          <time_verified> @linkml:Datetime ? ;
          <policy> @<InTotoResourceDescriptor> ;
          <input_attestations> @<InTotoResourceDescriptor> * ;
          <verification_result> [ <https://w3id.org/lmodel/slsa/SlsaVerificationResult#PASSED>
             <https://w3id.org/lmodel/slsa/SlsaVerificationResult#FAILED> ] ;
          <verified_levels> [ <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_UNEVALUATED>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_0>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_1>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_2>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_LEVEL_3>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_UNEVALUATED>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_0>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_1>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_2>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_3>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_LEVEL_4>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_SOURCE_TWO_PARTY_REVIEWED>
             <https://w3id.org/lmodel/slsa/SlsaResult#SLSA_BUILD_REPRODUCED> <https://w3id.org/lmodel/slsa/SlsaResult#FAILED> ] + ;
          <organization_properties> @linkml:String * ;
          <dependency_levels> @<SlsaDependencyLevelCount> * ;
          <slsa_version> @linkml:String ?
       ) ;
       rdf:type [ <SlsaVerificationSummary> ] ?
    )
}

<SlsaVerifier> CLOSED {
    (  $<SlsaVerifier_tes> (  &<SlsaParty_tes> ;
          rdf:type [ <SlsaParty> ] ? ;
          <component_versions> @<SlsaComponentVersion> * ;
          <verifier_id> @linkml:Uri
       ) ;
       rdf:type [ <SlsaVerifier> ] ?
    )
}
