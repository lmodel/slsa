@prefix OIO: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
@prefix schema1: <http://schema.org/> .
<https://w3id.org/lmodel/slsa/AUTOMATED> skos:note "At Source L4 an organization may still exempt a trusted robot's own changes from two-party review." ;
	linkml:description "A tool or bot reviewed the change with no second person, which is not two-party review." .
<https://w3id.org/lmodel/slsa/COLLABORATE_WITH_COMMUNITY> linkml:annotations _:c14n39 ;
	linkml:description "Align with industry standards, guide newcomers, and share knowledge across projects." .
<https://w3id.org/lmodel/slsa/COMPLEX_IMPLEMENTATION> skos:note "Sub-themes: complicated provenance generation (CI.1) and intricate tool maintenance (CI.2); 901 issues." ;
	linkml:annotations _:c14n43 ;
	linkml:description "Generating provenance and maintaining the required tools is complicated." .
<https://w3id.org/lmodel/slsa/ENHANCE_ALIGNMENT_FLEXIBILITY> linkml:annotations _:c14n86 ;
	linkml:description "Make SLSA fit more contexts, with build-system tracks, gamified levels, flexibility for varied organizations and alignment with OpenSSF practices." .
<https://w3id.org/lmodel/slsa/FAILED> linkml:description "Policy evaluation failed." , "The artifact did not meet the policy." ;
	linkml:meaning "http://www.w3.org/ns/earl#failed"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/IMPROVE_VERIFICATION_PROCESS> linkml:annotations _:c14n1 ;
	linkml:description "Strengthen verification and level determination, tag versions early, and give downstream users more signals." .
<https://w3id.org/lmodel/slsa/InTotoAdditionalDigest> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "An SCS that does not use cryptographic digests defines a canonical revision type of its own that includes the repository, such as svn_revision_id." , "Each algorithm appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." , "In the attestation's JSON the algorithm is a key of the digest set beside the named ones, and an algorithm the framework does not define documents how its value is encoded." , "It is related to, not the same as, an SPDX 3 Hash, whose algorithm comes from a closed list, where this one's may be a revision type rather than a digest." ;
	skos:relatedMatch "spdx_core:Hash"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/slsa/algorithm> , <https://w3id.org/lmodel/slsa/value> ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoAdditionalDigest"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoAdditionalDigest"^^xsd:anyURI ;
	linkml:description "One digest under an algorithm that InTotoDigestSet does not name, such as an SCS's own revision type." ;
	linkml:slot_usage _:c14n89 ;
	linkml:slots <https://w3id.org/lmodel/slsa/inTotoAdditionalDigest__algorithm> , <https://w3id.org/lmodel/slsa/inTotoAdditionalDigest__value> .
<https://w3id.org/lmodel/slsa/InTotoAnnotation> a linkml:ClassDefinition ;
	skos:closeMatch "spdx_core:DictionaryEntry"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "Each key appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." , "The attestation's JSON allows any JSON value. A string becomes one value and an array one value per item; any other value or item is written as its JSON text, so one value cannot tell a string from a one-item array." ;
	linkml:attributes <https://w3id.org/lmodel/slsa/annotation_key> , <https://w3id.org/lmodel/slsa/annotation_values> ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoAnnotation"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoAnnotation"^^xsd:anyURI ;
	linkml:description "One vendor-specific annotation on a resource descriptor: a key and its values." ;
	linkml:slot_usage _:c14n22 ;
	linkml:slots <https://w3id.org/lmodel/slsa/inTotoAnnotation__annotation_key> , <https://w3id.org/lmodel/slsa/inTotoAnnotation__annotation_values> .
<https://w3id.org/lmodel/slsa/InTotoDigestSet> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md"^^xsd:anyURI ;
	skos:altLabel "DigestSet" ;
	skos:editorialNote "Each condition in any_of names its range through a nested any_of, because the JSON Schema generator leaves a condition's own range out, and a null value would then count as present." ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "A consumer accepts only the algorithms it considers secure and ignores the rest, and two sets match when any accepted algorithm matches." , "A field named after an algorithm that SPDX 3 also names relates to SPDX's individual for it. BLAKE2b is left unmapped: the framework allows any length from 32 to 64 bytes, where SPDX names three fixed lengths." , "SHAKE and BLAKE2 digests can be of any length, and this schema asks for at least 32 bytes, since a shorter digest resists collisions too weakly to identify an artifact." , "The named algorithms take lowercase hexadecimal, and additional_digests holds any other algorithm, such as an SCS's own revision type." ;
	linkml:any_of _:c14n101 , _:c14n107 , _:c14n110 , _:c14n14 , _:c14n17 , _:c14n23 , _:c14n26 , _:c14n27 , _:c14n29 , _:c14n3 , _:c14n30 , _:c14n37 , _:c14n42 , _:c14n47 , _:c14n48 , _:c14n54 , _:c14n60 , _:c14n66 , _:c14n69 , _:c14n79 , _:c14n85 , _:c14n92 , _:c14n94 , _:c14n96 , _:c14n99 ;
	linkml:attributes <https://w3id.org/lmodel/slsa/additional_digests> , <https://w3id.org/lmodel/slsa/blake2b> , <https://w3id.org/lmodel/slsa/blake2s> , <https://w3id.org/lmodel/slsa/dir_hash> , <https://w3id.org/lmodel/slsa/git_blob> , <https://w3id.org/lmodel/slsa/git_commit> , <https://w3id.org/lmodel/slsa/git_tag> , <https://w3id.org/lmodel/slsa/git_tree> , <https://w3id.org/lmodel/slsa/gost> , <https://w3id.org/lmodel/slsa/md5> , <https://w3id.org/lmodel/slsa/ripemd160> , <https://w3id.org/lmodel/slsa/sha1> , <https://w3id.org/lmodel/slsa/sha224> , <https://w3id.org/lmodel/slsa/sha256> , <https://w3id.org/lmodel/slsa/sha384> , <https://w3id.org/lmodel/slsa/sha3_224> , <https://w3id.org/lmodel/slsa/sha3_256> , <https://w3id.org/lmodel/slsa/sha3_384> , <https://w3id.org/lmodel/slsa/sha3_512> , <https://w3id.org/lmodel/slsa/sha512> , <https://w3id.org/lmodel/slsa/sha512_224> , <https://w3id.org/lmodel/slsa/sha512_256> , <https://w3id.org/lmodel/slsa/shake128> , <https://w3id.org/lmodel/slsa/shake256> , <https://w3id.org/lmodel/slsa/sm3> ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoDigestSet"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoDigestSet"^^xsd:anyURI ;
	linkml:description "A set of one or more digests over one artifact, keyed by algorithm, from which a consumer picks the algorithm it trusts." ;
	linkml:slot_usage _:c14n58 ;
	linkml:slots <https://w3id.org/lmodel/slsa/inTotoDigestSet__additional_digests> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__blake2b> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__blake2s> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__dir_hash> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__git_blob> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__git_commit> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__git_tag> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__git_tree> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__gost> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__md5> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__ripemd160> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha1> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha224> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha256> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha384> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha3_224> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha3_256> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha3_384> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha3_512> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha512> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha512_224> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sha512_256> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__shake128> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__shake256> , <https://w3id.org/lmodel/slsa/inTotoDigestSet__sm3> .
<https://w3id.org/lmodel/slsa/InTotoPredicate> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/predicate.md"^^xsd:anyURI ;
	skos:altLabel "Predicate" ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "A predicate is of one kind only, so the kinds that extend this class are mutually disjoint." , "The statement's predicate_type names the predicate's type by URI, and each concrete class says which URI it renders. Nothing ties the two, since a schema that imports this module may model a predicate under its own URI." ;
	linkml:abstract true ;
	linkml:attributes <https://w3id.org/lmodel/slsa/predicate_kind> ;
	linkml:children_are_mutually_disjoint true ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoPredicate"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoPredicate"^^xsd:anyURI ;
	linkml:description "The base of every predicate an in-toto statement can carry; predicate_kind names the concrete kind." ;
	linkml:slot_usage _:c14n109 ;
	linkml:slots <https://w3id.org/lmodel/slsa/inTotoPredicate__predicate_kind> .
<https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/resource_descriptor.md"^^xsd:anyURI ;
	skos:altLabel "ResourceDescriptor" ;
	skos:editorialNote "Each condition in any_of names its range through a nested any_of, because the JSON Schema generator leaves a condition's own range out, and a null value would then count as present." ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "A descriptor carries at least one of a URI, a digest or its content; a field that needs a particular one says so." , "It describes an artifact, where an SPDX 3 Artifact is the artifact itself, so the two are related rather than the same." ;
	skos:relatedMatch "spdx_core:Artifact"^^xsd:anyURI ;
	linkml:any_of _:c14n11 , _:c14n35 , _:c14n97 ;
	linkml:attributes <https://w3id.org/lmodel/slsa/annotations> , <https://w3id.org/lmodel/slsa/content> , <https://w3id.org/lmodel/slsa/download_location> , <https://w3id.org/lmodel/slsa/media_type> , <https://w3id.org/lmodel/slsa/resource_name> ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor"^^xsd:anyURI ;
	linkml:description "A reference to a software artifact or other resource by URI or digest, or the resource itself as content, with optional metadata." ;
	linkml:slot_usage _:c14n90 ;
	linkml:slots <https://w3id.org/lmodel/slsa/digest> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__annotations> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__content> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__download_location> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__media_type> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__resource_name> , <https://w3id.org/lmodel/slsa/resource_uri> .
<https://w3id.org/lmodel/slsa/InTotoStatement> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/statement.md"^^xsd:anyURI ;
	skos:altLabel "Statement" ;
	skos:exactMatch "in_toto_io:Statement/v1"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "A statement is the attestation, and its predicate is one kind of claim about the subjects, such as a test result or build provenance." , "Its exact mapping is the type URI its statement_type holds, as each predicate class maps to its predicate_type." , "The signature envelope around a statement, and the bundle that collects signed statements, are outside this model." ;
	linkml:attributes <https://w3id.org/lmodel/slsa/predicate_type> , <https://w3id.org/lmodel/slsa/statement_type> , <https://w3id.org/lmodel/slsa/subject> ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoStatement"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoStatement"^^xsd:anyURI ;
	linkml:description "The statement layer of an in-toto attestation: the subjects it is about, the type of its predicate and the predicate itself." ;
	linkml:slot_usage _:c14n59 ;
	linkml:slots <https://w3id.org/lmodel/slsa/inTotoStatement__predicate_type> , <https://w3id.org/lmodel/slsa/inTotoStatement__statement_type> , <https://w3id.org/lmodel/slsa/inTotoStatement__subject> , <https://w3id.org/lmodel/slsa/predicate> .
<https://w3id.org/lmodel/slsa/InTotoStatementSubject> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/statement.md"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoStatementSubject"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoStatementSubject"^^xsd:anyURI ;
	linkml:description "One artifact an in-toto statement is about: a resource descriptor that carries a digest." ;
	linkml:is_a <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:slot_usage _:c14n102 ;
	linkml:slots <https://w3id.org/lmodel/slsa/InTotoStatementSubject_digest> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__annotations> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__content> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__download_location> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__media_type> , <https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__resource_name> , <https://w3id.org/lmodel/slsa/resource_uri> .
<https://w3id.org/lmodel/slsa/InTotoStatementSubject_digest> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/digest"^^xsd:anyURI ;
	skos:prefLabel "digest" ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/digest"^^xsd:anyURI ;
	linkml:description "The cryptographic digests of a resource's content, keyed by algorithm." ;
	linkml:domain <https://w3id.org/lmodel/slsa/InTotoStatementSubject> ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoStatementSubject> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:is_a <https://w3id.org/lmodel/slsa/digest> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoStatementSubject> ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoDigestSet> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/digest"^^xsd:anyURI ;
	linkml:usage_slot_name "digest" .
<https://w3id.org/lmodel/slsa/LIMITED_FEASIBILITY> skos:note "Sub-themes: limited attestation verification, including where attestations are stored (LF.1), and two-party review requirements, which projects with one maintainer find hard to meet (LF.2); 219 issues." ;
	linkml:annotations _:c14n61 ;
	linkml:description "Verification tooling, attestation storage and two-party review are hard to put into practice." .
<https://w3id.org/lmodel/slsa/MOB_PROGRAMMING> linkml:description "A group wrote the change together; whether this counts as two-party review is open." .
<https://w3id.org/lmodel/slsa/PAIR_PROGRAMMING> linkml:description "Two developers wrote the change together at one workstation or screen; whether this counts as two-party review is open." .
<https://w3id.org/lmodel/slsa/PASSED> linkml:description "The artifact met the policy." ;
	linkml:meaning "http://www.w3.org/ns/earl#passed"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/PROVIDE_DETAILED_DOCUMENTATION> linkml:annotations _:c14n71 ;
	linkml:description "Give clearer definitions, standard terms, negative examples and better navigation." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_ENV_LEVEL_0> linkml:description "No Build Environment track claims." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_ENV_LEVEL_1> linkml:description "The build image has signed build provenance, protecting against tampering while the image is distributed." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_ENV_LEVEL_2> linkml:description "The compute platform attests to the environment's state at boot, protecting against tampering through the control plane." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_ENV_LEVEL_3> linkml:description "Trusted hardware attests to the host's state, protecting against tampering through the host interface." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_LEVEL_0> linkml:description "No Build track guarantees were verified." , "No requirements; the absence of SLSA, as for development or test builds." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_LEVEL_1> linkml:description "Build level 1 was verified." , "Provenance exists and shows how the package was built; it prevents mistakes but is easy to forge." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_LEVEL_2> skos:note "Keeping the provenance generator, the verifier and signing tools such as cosign working in CI workflows was a common difficulty (Tamanna et al., 2024, CI.2)." ;
	linkml:description "A hosted platform generates and signs the provenance, so tampering after the build needs an explicit attack." , "Build level 2 was verified." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_LEVEL_3> skos:note "Practitioners reported difficulty in generating provenance for the higher levels (Tamanna et al., 2024, CI.1)." ;
	linkml:description "A hardened platform prevents runs from influencing one another and keeps signing material away from build steps, so forging provenance needs an exploit." , "Build level 3 was verified." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_LEVEL_UNEVALUATED> linkml:description "The issuer makes no claim about the Build track level." .
<https://w3id.org/lmodel/slsa/SLSA_BUILD_REPRODUCED> linkml:description "The verified property that two or more independent build platforms reproduced the artifact." .
<https://w3id.org/lmodel/slsa/SLSA_DEPENDENCY_LEVEL_0> linkml:description "No Dependency track claims." .
<https://w3id.org/lmodel/slsa/SLSA_DEPENDENCY_LEVEL_1> linkml:description "An inventory of all build dependencies, direct and transitive, exists." .
<https://w3id.org/lmodel/slsa/SLSA_DEPENDENCY_LEVEL_2> linkml:description "Every known vulnerability in the dependencies was triaged before release." .
<https://w3id.org/lmodel/slsa/SLSA_DEPENDENCY_LEVEL_3> linkml:description "Every third-party build dependency is consumed from a location the producer controls." .
<https://w3id.org/lmodel/slsa/SLSA_DEPENDENCY_LEVEL_4> linkml:description "An ingestion policy keeps compromised upstream dependencies out of the build." .
<https://w3id.org/lmodel/slsa/SLSA_SOURCE_LEVEL_0> linkml:description "No Source track guarantees were verified." , "No Source track guarantees; a revision for which the SCS issues no Source VSA is at this level." .
<https://w3id.org/lmodel/slsa/SLSA_SOURCE_LEVEL_1> linkml:description "Source level 1 was verified." , "The source is managed in a version control system, so it has discrete, immutable revisions." .
<https://w3id.org/lmodel/slsa/SLSA_SOURCE_LEVEL_2> linkml:description "Branch history is continuous and retained, and the SCS issues source provenance for each new revision." , "Source level 2 was verified." .
<https://w3id.org/lmodel/slsa/SLSA_SOURCE_LEVEL_3> linkml:description "Source level 3 was verified." , "The SCS enforces the organization's technical controls on protected named references and provides evidence of them." .
<https://w3id.org/lmodel/slsa/SLSA_SOURCE_LEVEL_4> skos:note "Whether pair or mob programming counts as two-party review is an open question (Tamanna et al., 2024, LF.2)." ;
	linkml:description "Source level 4 was verified." , "Two trusted persons agree to every change on protected branches." .
<https://w3id.org/lmodel/slsa/SLSA_SOURCE_LEVEL_UNEVALUATED> linkml:description "The issuer makes no claim about the Source track level." .
<https://w3id.org/lmodel/slsa/SLSA_SOURCE_TWO_PARTY_REVIEWED> linkml:description "The verified property that two trusted persons reviewed the source, at whatever source level." .
<https://w3id.org/lmodel/slsa/STREAMLINE_PROVENANCE_GENERATION> linkml:annotations _:c14n5 ;
	linkml:description "Simplify and standardize provenance generation with tools and templates, and fix release-tool inconsistencies." .
<https://w3id.org/lmodel/slsa/SlsaAdoptionChallenge> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_adoption_study> ;
	rdfs:seeAlso "https://arxiv.org/abs/2409.05014"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_adoption"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaAdoptionChallenge"^^xsd:anyURI ;
	linkml:description "The four themes of difficulty practitioners met when adopting SLSA." ;
	linkml:permissible_values <https://w3id.org/lmodel/slsa/COMPLEX_IMPLEMENTATION> , <https://w3id.org/lmodel/slsa/LIMITED_FEASIBILITY> , <https://w3id.org/lmodel/slsa/UNCLEAR_COMMUNICATION> , <https://w3id.org/lmodel/slsa/UNCLEAR_RELEVANCE> .
<https://w3id.org/lmodel/slsa/SlsaAdoptionMetadata> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_adoption_study> ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://arxiv.org/abs/2409.05014"^^xsd:anyURI ;
	skos:editorialNote "The study analysed 1,523 SLSA-related GitHub issues from 233 repositories and derived four challenge themes and five strategy themes." ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_adoption"^^xsd:anyURI ;
