	linkml:slots <https://w3id.org/lmodel/slsa/repository> , <https://w3id.org/lmodel/slsa/slsaSourceRevision__authored_at> , <https://w3id.org/lmodel/slsa/slsaSourceRevision__authored_by> , <https://w3id.org/lmodel/slsa/slsaSourceRevision__parent_revisions> , <https://w3id.org/lmodel/slsa/slsaSourceRevision__review_type> , <https://w3id.org/lmodel/slsa/slsaSourceRevision__revision_id> , <https://w3id.org/lmodel/slsa/slsaSourceRevision__source_level> .
<https://w3id.org/lmodel/slsa/SlsaStatement> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_build_environment_track> , <https://w3id.org/lmodel/slsa/slsa_build_track> , <https://w3id.org/lmodel/slsa/slsa_source_track> ;
	a linkml:ClassDefinition ;
	rdfs:seeAlso "https://slsa.dev/spec/v1.2/attestation-model"^^xsd:anyURI , "https://slsa.dev/spec/v1.2/distributing-provenance"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	skos:note "Attestation and provenance are often confused; a statement is the attestation, and build provenance is one kind of predicate it may carry (Tamanna et al., 2024, UC.1)." , "InTotoStatement comes from lmodel/in-toto and holds only what the in-toto specification defines, so the fields SLSA's adoption study and the Secure Software Factory add live on this subclass. A statement without them is a valid SlsaStatement too." ;
	linkml:attributes <https://w3id.org/lmodel/slsa/attestation_storage_uri> , <https://w3id.org/lmodel/slsa/signing_tool> , <https://w3id.org/lmodel/slsa/transparency_log_entry> ;
	linkml:class_uri "https://w3id.org/lmodel/slsa/SlsaStatement"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaStatement"^^xsd:anyURI ;
	linkml:description "An in-toto statement with the fields this schema adds: where the signed attestation is stored, the tool that signed it and the transparency log entry that records the signature." ;
