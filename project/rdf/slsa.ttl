	a linkml:SlotDefinition ;
	skos:note "In the Secure Software Factory architecture this is the Build Service layer, distinct from the provenance-generating builder." ;
	linkml:description "The CI/CD system that coordinated the build, named by URI, where it differs from the builder." ;
	linkml:range <https://w3id.org/lmodel/slsa/uri> .
<https://w3id.org/lmodel/slsa/policy> a linkml:SlotDefinition ;
	linkml:description "The policy the subject was verified against, by URI and preferably by digest too." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaVerificationSummaryPolicy> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/predicate> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/statement.md"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/predicate"^^xsd:anyURI ;
	skos:note "It is a slot of its own rather than an attribute of InTotoStatement, because LOKF's predicate is a relation's type: `lokf adapt` renames a slot whose name LOKF defines, with the name of the schema it adapts as a prefix, and keeps its IRI. This repository's copy calls it in_toto_linkml_predicate, and lmodel/slsa's calls it slsa_predicate." ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/predicate"^^xsd:anyURI ;
	linkml:description "The predicate, one of the kinds this schema or an importing one models; predicate_kind names which. Unset means the same as empty." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoStatement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoStatement> ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoPredicate> ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/predicate"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/predicate_kind> a linkml:SlotDefinition ;
	linkml:description "The kind of predicate, one of this class's descendants." ;
	linkml:designates_type true ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "in_toto_linkml:predicate_kind"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/predicate_type> a linkml:SlotDefinition ;
	skos:altLabel "predicateType" ;
	linkml:description "The URI that names the predicate's type and so its schema, such as https://in-toto.io/attestation/test-result/v0.1." ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_type_uri> ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:predicate_type"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/produced_by> a linkml:SlotDefinition ;
	linkml:description "The party that created and distributes the image." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildImageProducer> .
<https://w3id.org/lmodel/slsa/protected> a linkml:SlotDefinition ;
	linkml:description "Whether the organization has the SCS enforce its technical controls on this reference." ;
	linkml:range <https://w3id.org/lmodel/slsa/boolean> .
<https://w3id.org/lmodel/slsa/provenance> a linkml:SlotDefinition ;
	linkml:description "The build provenance of the image itself, required at Build Environment L1." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildProvenance> .
<https://w3id.org/lmodel/slsa/provenance_generation_tool> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_adoption_study> ;
	a linkml:SlotDefinition ;
	skos:note "Naming the generator supports the strategy of standardizing provenance generation (Tamanna et al., 2024, S3.1)." ;
	linkml:description "The tool that generated this provenance, named by URI." ;
	linkml:range <https://w3id.org/lmodel/slsa/uri> .
<https://w3id.org/lmodel/slsa/reference_name> a linkml:SlotDefinition ;
	linkml:description "The reference's name, fully qualified in git, such as refs/heads/main." ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/reference_type> a linkml:SlotDefinition ;
	linkml:description "The kind of named reference, one of this class's descendants." ;
	linkml:designates_type true ;
	linkml:range <https://w3id.org/lmodel/slsa/string> .
<https://w3id.org/lmodel/slsa/registry> a linkml:SlotDefinition ;
	linkml:description "The registry the package is published to." ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaPackageRegistry> .
<https://w3id.org/lmodel/slsa/registry_uri> a linkml:SlotDefinition ;
	linkml:description "The URI that identifies the registry." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/slsa/uri> .
<https://w3id.org/lmodel/slsa/repository> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_source_track> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_source"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/slsa/repository"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/repository"^^xsd:anyURI ;
	linkml:description "The source repository this belongs to." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaNamedReference> , <https://w3id.org/lmodel/slsa/SlsaSourceRevision> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaNamedReference> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaSourceRepository> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/repository"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/repository_uri> a linkml:SlotDefinition ;
	skos:closeMatch "doap:location"^^xsd:anyURI ;
	linkml:description "The stable locator the SCS gives the repository." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/slsa/uri> .
<https://w3id.org/lmodel/slsa/resolved_dependencies> a linkml:SlotDefinition ;
	skos:altLabel "resolvedDependencies" ;
	skos:relatedMatch "spdx_build:configSourceDigest"^^xsd:anyURI , "spdx_build:configSourceUri"^^xsd:anyURI ;
	linkml:description "The artifacts fetched during the build, as far as the platform knows them; completeness is best effort through Build L3." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> .
<https://w3id.org/lmodel/slsa/resource_name> a linkml:SlotDefinition ;
	skos:altLabel "name" ;
	linkml:description "A name for the resource within the attestation that carries it." ;
	linkml:slot_uri "in_toto_linkml:resource_name"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/resource_uri> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#resourceuri"^^xsd:anyURI ;
	skos:altLabel "uri" ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/resource_uri"^^xsd:anyURI ;
	linkml:any_of _:c14n51 ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/resource_uri"^^xsd:anyURI ;
	linkml:description "The URI that identifies a resource, such as a package URL, a git repository address or an OCI image reference." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> , <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_resource_uri> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/resource_uri"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/review_type> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_adoption_study> ;
	a linkml:SlotDefinition ;
	linkml:description "The form of review that approved the revision." ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaReviewType> .
<https://w3id.org/lmodel/slsa/revision> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_source_track> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_source"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/slsa/revision"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/revision"^^xsd:anyURI ;
	linkml:description "The source revision this refers to." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaNamedReference> , <https://w3id.org/lmodel/slsa/SlsaSourceProvenance> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaSourceProvenance> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaSourceRevision> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/revision"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/revision_id> a linkml:SlotDefinition ;
	linkml:description "The revision identifier the SCS assigns, such as a git commit id or a path- qualified sequence number." ;
	linkml:identifier true .
<https://w3id.org/lmodel/slsa/ripemd160> a linkml:SlotDefinition ;
	linkml:any_of _:c14n2 ;
	linkml:description "The RIPEMD-160 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{40}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:ripemd160"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/run_details> a linkml:SlotDefinition ;
	skos:altLabel "runDetails" ;
	linkml:description "What is specific to this execution of the build; required at Build L1." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaRunDetails> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/scs_uri> a linkml:SlotDefinition ;
	linkml:description "The URI that identifies the source control system." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/slsa/uri> .
<https://w3id.org/lmodel/slsa/security_insights_uri> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_ssf> ;
	a linkml:SlotDefinition ;
	linkml:description "The SECURITY-INSIGHTS.yml file of the project that produces the package." ;
	linkml:range <https://w3id.org/lmodel/slsa/uri> .
<https://w3id.org/lmodel/slsa/sha1> a linkml:SlotDefinition ;
	skos:note "SHA-1 lacks collision resistance, so most consumers should not rely on it." ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha1"^^xsd:anyURI ;
	linkml:any_of _:c14n57 ;
	linkml:description "The SHA-1 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{40}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha1"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha224> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha224"^^xsd:anyURI ;
	linkml:any_of _:c14n40 ;
	linkml:description "The SHA-224 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{56}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha224"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha256> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha256"^^xsd:anyURI ;
	linkml:any_of _:c14n84 ;
	linkml:description "The SHA-256 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha256"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha384> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha384"^^xsd:anyURI ;
	linkml:any_of _:c14n41 ;
	linkml:description "The SHA-384 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{96}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha384"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha3_224> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha3_224"^^xsd:anyURI ;
	linkml:any_of _:c14n87 ;
	linkml:description "The SHA3-224 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{56}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha3_224"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha3_256> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha3_256"^^xsd:anyURI ;
	linkml:any_of _:c14n80 ;
	linkml:description "The SHA3-256 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha3_256"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha3_384> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha3_384"^^xsd:anyURI ;
	linkml:any_of _:c14n0 ;
	linkml:description "The SHA3-384 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{96}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha3_384"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha3_512> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha3_512"^^xsd:anyURI ;
	linkml:any_of _:c14n21 ;
	linkml:description "The SHA3-512 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{128}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha3_512"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha512> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha512"^^xsd:anyURI ;
	linkml:any_of _:c14n56 ;
	linkml:description "The SHA-512 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{128}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha512"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha512_224> a linkml:SlotDefinition ;
	linkml:any_of _:c14n44 ;
	linkml:description "The SHA-512/224 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{56}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha512_224"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/sha512_256> a linkml:SlotDefinition ;
	linkml:any_of _:c14n32 ;
	linkml:description "The SHA-512/256 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha512_256"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/shake128> a linkml:SlotDefinition ;
	linkml:any_of _:c14n12 ;
	linkml:description "The SHAKE128 digest of the artifact, of at least 32 bytes." ;
	linkml:pattern "^[a-f0-9]{64}([a-f0-9]{2})*$" ;
