	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_source"^^xsd:anyURI ;
	skos:note "A revision id is unique within its repository and may recur in another; a document that holds revisions from several repositories qualifies them." ;
	linkml:attributes <https://w3id.org/lmodel/slsa/authored_at> , <https://w3id.org/lmodel/slsa/authored_by> , <https://w3id.org/lmodel/slsa/parent_revisions> , <https://w3id.org/lmodel/slsa/review_type> , <https://w3id.org/lmodel/slsa/revision_id> , <https://w3id.org/lmodel/slsa/source_level> ;
