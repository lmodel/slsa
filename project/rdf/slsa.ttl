<https://w3id.org/lmodel/slsa/slsaBuildDefinition__external_parameters> a linkml:SlotDefinition ;
	skos:altLabel "externalParameters" ;
	skos:broadMatch "https://spdx.org/rdf/3.0.1/terms/Build/parameter"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_build"^^xsd:anyURI ;
	skos:note "SPDX's configSource fields name the three parts of SLSA 0.2's configSource, which SLSA 1.0 records as external parameters for its entry point and URI, and as a resolved dependency for its URI and digest." , "Verifiers reject parameters they do not recognize here." ;
	skos:prefLabel "external_parameters" ;
	skos:relatedMatch "https://spdx.org/rdf/3.0.1/terms/Build/configSourceEntrypoint"^^xsd:anyURI , "https://spdx.org/rdf/3.0.1/terms/Build/configSourceUri"^^xsd:anyURI ;
	linkml:description "The inputs under the tenant's control; required at Build L1, complete at Build L3 and verified by consumers." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaBuildDefinition> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaBuildDefinition> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildParameter> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/external_parameters"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsaBuildDefinition__hermetic> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_adoption_study> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_build"^^xsd:anyURI ;
	skos:note "SLSA v1.2 does not require hermetic builds; Build L3's isolation is a different property, and hermeticity is a candidate for a future Build L4." , "The study cites a 2023 industry survey in which over half the participants found hermetic builds hard to implement, and lists \"hermetic build\" among SLSA's unclear terms (Tamanna et al., 2024, UC.1)." ;
	skos:prefLabel "hermetic" ;
	linkml:description "Whether the build could reach only the dependencies it declared, with no other network or filesystem access." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaBuildDefinition> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaBuildDefinition> ;
	linkml:range <https://w3id.org/lmodel/slsa/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/hermetic"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsaBuildDefinition__internal_parameters> a linkml:SlotDefinition ;
	skos:altLabel "internalParameters" ;
	skos:closeMatch "https://spdx.org/rdf/3.0.1/terms/Build/environment"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_build"^^xsd:anyURI ;
	skos:note "Close to SPDX's environment, the session the build ran in: SLSA 1.0 renamed 0.2's environment to internalParameters, with a slight change in meaning." , "Related, not narrower: SPDX's parameter is an input provided to the builder, and an internal parameter is one the platform sets itself." ;
	skos:prefLabel "internal_parameters" ;
	skos:relatedMatch "https://spdx.org/rdf/3.0.1/terms/Build/parameter"^^xsd:anyURI ;
	linkml:description "The inputs the platform sets itself; kept for debugging, incident response and reproduction, and not verified by consumers." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaBuildDefinition> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaBuildDefinition> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildParameter> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/internal_parameters"^^xsd:anyURI .
