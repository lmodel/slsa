	linkml:slot_uri "https://w3id.org/lmodel/in-toto/shake128"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoDigestSet__shake256> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/shake256"^^xsd:anyURI ;
	skos:prefLabel "shake256" ;
	linkml:description "The SHAKE256 digest of the artifact, of at least 32 bytes." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoDigestSet> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoDigestSet> ;
	linkml:pattern "^[a-f0-9]{64}([a-f0-9]{2})*$" ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/shake256"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoDigestSet__sm3> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/sm3"^^xsd:anyURI ;
	skos:prefLabel "sm3" ;
	linkml:description "The SM3 digest of the artifact." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoDigestSet> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoDigestSet> ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/sm3"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoPredicate__predicate_kind> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/predicate_kind"^^xsd:anyURI ;
	skos:prefLabel "predicate_kind" ;
	linkml:description "The kind of predicate, one of this class's descendants." ;
	linkml:designates_type true ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoPredicate> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoPredicate> ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/predicate_kind"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__annotations> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/annotations"^^xsd:anyURI ;
	skos:prefLabel "annotations" ;
	linkml:description "Vendor-specific annotations on the resource, such as the source references a SLSA Source Verification Summary records." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoAnnotation> ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/annotations"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__content> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/content"^^xsd:anyURI ;
	skos:note "The in-toto framework asks for content under 1 KB, so that attestations stay small." ;
	skos:prefLabel "content" ;
	linkml:description "The resource's content itself, base64-encoded, for a resource small enough to carry inline." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:pattern "^[A-Za-z0-9+/_-]+={0,2}$" ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/content"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__download_location> a linkml:SlotDefinition ;
	skos:altLabel "downloadLocation" ;
	skos:closeMatch "http://www.w3.org/ns/dcat#downloadURL"^^xsd:anyURI , "https://spdx.org/rdf/3.0.1/terms/Software/downloadLocation"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/download_location"^^xsd:anyURI ;
	skos:prefLabel "download_location" ;
	linkml:description "Where the resource can be fetched, when that differs from its identifying URI." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_resource_uri> ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/download_location"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__media_type> a linkml:SlotDefinition ;
	skos:altLabel "mediaType" ;
	skos:closeMatch "https://spdx.org/rdf/3.0.1/terms/Core/contentType"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "http://www.w3.org/ns/dcat#mediaType"^^xsd:anyURI ;
	skos:prefLabel "media_type" ;
	linkml:description "The IANA media type of the resource's content." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "http://www.w3.org/ns/dcat#mediaType"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoResourceDescriptor__resource_name> a linkml:SlotDefinition ;
	skos:altLabel "name" ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/resource_name"^^xsd:anyURI ;
	skos:prefLabel "resource_name" ;
	linkml:description "A name for the resource within the attestation that carries it." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/resource_name"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoStatement__predicate_type> a linkml:SlotDefinition ;
	skos:altLabel "predicateType" ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/predicate_type"^^xsd:anyURI ;
	skos:prefLabel "predicate_type" ;
	linkml:description "The URI that names the predicate's type and so its schema, such as https://in-toto.io/attestation/test-result/v0.1." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoStatement> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoStatement> ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_type_uri> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/predicate_type"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoStatement__statement_type> a linkml:SlotDefinition ;
	skos:altLabel "_type" ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/statement_type"^^xsd:anyURI ;
	skos:prefLabel "statement_type" ;
	linkml:description "The in-toto statement type, always https://in-toto.io/Statement/v1." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoStatement> ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoStatement> ;
	linkml:pattern "^https://in-toto\\.io/Statement/v1$" ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_type_uri> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/statement_type"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoStatement__subject> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/subject"^^xsd:anyURI ;
	skos:prefLabel "subject" ;
	linkml:description "The artifacts the predicate is about, each with a digest." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoStatement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoStatement> ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoStatementSubject> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/subject"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/in_toto_resource_uri> a linkml:TypeDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#resourceuri"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "The framework recommends a package URL (pkg:) or an SPDX download location (git+https:), and allows one that does not resolve." ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoResourceUri"^^xsd:anyURI ;
	linkml:description "A URI that identifies or locates a resource, such as a package URL or a git repository address, with its scheme and authority in lowercase." ;
	linkml:pattern "^[a-z][a-z0-9+.-]*:(//[^/?#A-Z]*([/?#].*)?|[^/].*|/[^/].*|/)?$" ;
	linkml:repr "str" ;
	linkml:typeof <https://w3id.org/lmodel/slsa/uri> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/in_toto_timestamp> a linkml:TypeDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#timestamp"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "It extends string rather than datetime, because the LinkML Python runtime writes a datetime's Z as +00:00, which the framework does not allow." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoTimestamp"^^xsd:anyURI ;
	linkml:description "A point in time in RFC 3339 format in the UTC time zone, written with a trailing Z, such as 1985-04-12T23:20:50.52Z." ;
	linkml:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" ;
	linkml:typeof <https://w3id.org/lmodel/slsa/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/in_toto_type_uri> a linkml:TypeDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#typeuri"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "The framework asks that it carry a version and registers none, since the namespace of a URI keeps two types apart." ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoTypeUri"^^xsd:anyURI ;
	linkml:description "A URI that names a type, such as a statement's or a predicate's, with its scheme and authority in lowercase." ;
	linkml:pattern "^[a-z][a-z0-9+.-]*:(//[^/?#A-Z]*([/?#].*)?|[^/].*|/[^/].*|/)?$" ;
	linkml:repr "str" ;
	linkml:typeof <https://w3id.org/lmodel/slsa/uri> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/input_attestations> a linkml:SlotDefinition ;
	skos:altLabel "inputAttestations" ;
	linkml:description "Every attestation the verifier consulted, each with a digest; complete when present." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaVerificationSummaryInputAttestation> .
<https://w3id.org/lmodel/slsa/integer> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"." ;
	skos:exactMatch "schema:Integer"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/linkml/Integer"^^xsd:anyURI ;
	linkml:description "An integer" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/internal_parameters> a linkml:SlotDefinition ;
	skos:altLabel "internalParameters" ;
	skos:closeMatch "spdx_build:environment"^^xsd:anyURI ;
	skos:note "Close to SPDX's environment, the session the build ran in: SLSA 1.0 renamed 0.2's environment to internalParameters, with a slight change in meaning." , "Related, not narrower: SPDX's parameter is an input provided to the builder, and an internal parameter is one the platform sets itself." ;
	skos:relatedMatch "spdx_build:parameter"^^xsd:anyURI ;
	linkml:description "The inputs the platform sets itself; kept for debugging, incident response and reproduction, and not verified by consumers." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildParameter> .
<https://w3id.org/lmodel/slsa/invocation_id> a linkml:SlotDefinition ;
	skos:altLabel "invocationId" ;
	skos:closeMatch "spdx_build:buildId"^^xsd:anyURI ;
	linkml:description "An identifier for this build invocation, in a format the builder defines; useful for finding its logs." .
<https://w3id.org/lmodel/slsa/jsonpath> dcterms:conformsTo "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Jsonpath"^^xsd:anyURI ;
	linkml:description "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/jsonpointer> dcterms:conformsTo "https://datatracker.ietf.org/doc/html/rfc6901" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Jsonpointer"^^xsd:anyURI ;
	linkml:description "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/md5> a linkml:SlotDefinition ;
	skos:note "MD5 lacks collision resistance, so most consumers should not accept it." ;
	skos:relatedMatch "spdx_core:HashAlgorithm/md5"^^xsd:anyURI ;
	linkml:any_of _:c14n50 ;
	linkml:description "The MD5 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{32}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:md5"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/measured_component> a linkml:SlotDefinition ;
	linkml:description "The component or state that was measured, such as the bootloader, guest kernel, build agent or root filesystem." ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/measurements> a linkml:SlotDefinition ;
	linkml:description "The measurements of the environment's components taken during boot." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaMeasurement> .
<https://w3id.org/lmodel/slsa/media_type> a linkml:SlotDefinition ;
	skos:altLabel "mediaType" ;
	skos:closeMatch "spdx_core:contentType"^^xsd:anyURI ;
	linkml:description "The IANA media type of the resource's content." ;
	linkml:slot_uri "dcat:mediaType"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/named_references> a linkml:SlotDefinition ;
	linkml:description "The branches and tags." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaNamedReference> .
<https://w3id.org/lmodel/slsa/ncname> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "NCName" ;
	linkml:definition_uri "https://w3id.org/linkml/Ncname"^^xsd:anyURI ;
	linkml:description "Prefix part of CURIE" ;
	linkml:imported_from "linkml:types" ;
