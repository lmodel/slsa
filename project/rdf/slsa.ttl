	rdfs:seeAlso "https://slsa.dev/spec/v1.2/source-requirements#source-provenance-attestations"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_source"^^xsd:anyURI ;
	skos:note "SLSA leaves the format of source provenance to each SCS and defines no predicate type for it; this class holds what the specification says such provenance conveys." , "Source L2 and above require the SCS to issue it with each new revision." ;
	linkml:attributes <https://w3id.org/lmodel/slsa/controls_enforced> ;
