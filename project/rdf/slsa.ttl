	linkml:class_uri "https://w3id.org/lmodel/slsa/SlsaSourceRepository"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaSourceRepository"^^xsd:anyURI ;
