<https://w3id.org/lmodel/slsa/slsaVerificationSummary__organization_properties> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_source_track> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_verification"^^xsd:anyURI ;
	skos:prefLabel "organization_properties" ;
	linkml:deprecated "Write these properties in verified_levels, where the attestation's JSON puts them; this field goes in a later release." ;
	linkml:deprecated_element_has_possible_replacement "slsa:verified_levels"^^xsd:anyURI ;
	linkml:description "Properties the organization defines for the revision, each prefixed ORG_SOURCE_; ORG_SOURCE_INTERNAL_ marks one not meant for external consumers." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:pattern "^ORG_SOURCE_" ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/organization_properties"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsaVerificationSummary__policy> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_verification"^^xsd:anyURI ;
	skos:prefLabel "policy" ;
	linkml:description "The policy the subject was verified against, by URI and preferably by digest too." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaVerificationSummaryPolicy> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/policy"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsaVerificationSummary__slsa_version> a linkml:SlotDefinition ;
	skos:altLabel "slsaVersion" ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_verification"^^xsd:anyURI ;
	skos:prefLabel "slsa_version" ;
	linkml:description "The SLSA specification version the verifier applied, as MAJOR.MINOR." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:pattern "^[0-9]+\\.[0-9]+$" ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/slsa_version"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsaVerificationSummary__time_verified> a linkml:SlotDefinition ;
	skos:altLabel "timeVerified" ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_verification"^^xsd:anyURI ;
	skos:prefLabel "time_verified" ;
	linkml:description "When the verification happened." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_timestamp> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/time_verified"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsaVerificationSummary__verification_result> a linkml:SlotDefinition ;
	skos:altLabel "verificationResult" ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_verification"^^xsd:anyURI ;
	skos:prefLabel "verification_result" ;
	linkml:description "Whether the subject passed the policy." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaVerificationResult> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/verification_result"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsaVerificationSummary__verified_levels> a linkml:SlotDefinition ;
	skos:altLabel "verifiedLevels" ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_verification"^^xsd:anyURI ;
	skos:note "A VSA lists at most one level per track, and only FAILED when verification failed; the validator checks neither." ;
	skos:prefLabel "verified_levels" ;
	linkml:description "The highest level verified in each track, any verified property, and any result of the issuer's own; a level implies the levels below it." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:pattern "^(SLSA_BUILD_LEVEL_(UNEVALUATED|[0-3])|SLSA_SOURCE_LEVEL_(UNEVALUATED|[0-4])|SLSA_SOURCE_TWO_PARTY_REVIEWED|SLSA_BUILD_REPRODUCED|([!-RT-rt-~]|[Ss]$|[Ss][!-KM-km-~]|[Ss][Ll]$|[Ss][Ll][!-RT-rt-~]|[Ss][Ll][Ss]$|[Ss][Ll][Ss][!-@B-`b-~]|[Ss][Ll][Ss][Aa]$|[Ss][Ll][Ss][Aa][!-^`-~])[!-~]*)$" ;
	linkml:range <https://w3id.org/lmodel/slsa/slsa_result_value> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/verified_levels"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsaVerificationSummary__verifier> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_verification"^^xsd:anyURI ;
	skos:prefLabel "verifier" ;
	linkml:description "The verifier that made this determination." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaVerifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/verifier"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsaVerifier__verifier_id> a linkml:SlotDefinition ;
	skos:altLabel "id" ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	skos:prefLabel "verifier_id" ;
	linkml:description "The URI that identifies the verifier." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaVerifier> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaVerifier> ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_type_uri> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/verifier_id"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsa_adoption_study> a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaAdoptionStudy"^^xsd:anyURI ;
	linkml:description "Elements this schema adds from an empirical study of SLSA adoption (Tamanna et al., 2024, arXiv:2409.05014). They are not part of the SLSA specification." .
<https://w3id.org/lmodel/slsa/slsa_build_environment_track> a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentTrack"^^xsd:anyURI ;
	linkml:description "Elements of the SLSA Build Environment track, a working-draft track for the integrity of the compute environment that runs builds." .
<https://w3id.org/lmodel/slsa/slsa_build_track> a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaBuildTrack"^^xsd:anyURI ;
	linkml:description "Elements of the SLSA Build track, which measures the trustworthiness of a build and its provenance." .
<https://w3id.org/lmodel/slsa/slsa_dependency_track> a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaDependencyTrack"^^xsd:anyURI ;
	linkml:description "Elements of the SLSA Dependency track, a working-draft track for managing risk from third-party dependencies." .
<https://w3id.org/lmodel/slsa/slsa_result_value> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_build_track> , <https://w3id.org/lmodel/slsa/slsa_source_track> ;
	a linkml:TypeDefinition ;
	rdfs:seeAlso "https://slsa.dev/spec/v1.2/verification_summary#slsaresult"^^xsd:anyURI ;
	skos:editorialNote "The pattern lists the values of SlsaResult that start with SLSA_ and then admits any other value that does not, written without a lookahead, which SHACL's regular expressions lack. One type in place of any_of over the enum and a pattern keeps the OWL output valid, since gen-owl makes the enum a class." , "tests/test_schema_rules.py checks the pattern against SlsaResult." , "verified_levels and verified_level repeat the pattern through a YAML anchor, because gen-pydantic checks a slot's pattern but not its type's." ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_verification"^^xsd:anyURI ;
	skos:note "An issuer's own result, such as an organization's ORG_SOURCE_ property, is printable ASCII with no spaces and does not start with SLSA_ in any letter case, so that it cannot pass for an SLSA result." , "It names the base its typeof already gives, because the SQL generator reads base alone and reports a type without one." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaResultValue"^^xsd:anyURI ;
	linkml:description "A result as a VSA writes it: one of the SLSA-defined results SlsaResult lists, or one of the issuer's own, which never starts with SLSA_." ;
	linkml:pattern "^(SLSA_BUILD_LEVEL_(UNEVALUATED|[0-3])|SLSA_SOURCE_LEVEL_(UNEVALUATED|[0-4])|SLSA_SOURCE_TWO_PARTY_REVIEWED|SLSA_BUILD_REPRODUCED|([!-RT-rt-~]|[Ss]$|[Ss][!-KM-km-~]|[Ss][Ll]$|[Ss][Ll][!-RT-rt-~]|[Ss][Ll][Ss]$|[Ss][Ll][Ss][!-@B-`b-~]|[Ss][Ll][Ss][Aa]$|[Ss][Ll][Ss][Aa][!-^`-~])[!-~]*)$" ;
	linkml:typeof <https://w3id.org/lmodel/slsa/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/slsa_source_track> a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaSourceTrack"^^xsd:anyURI ;
	linkml:description "Elements of the SLSA Source track, which measures how source revisions are created and managed." .
<https://w3id.org/lmodel/slsa/slsa_ssf> a linkml:SubsetDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/SlsaSsf"^^xsd:anyURI ;
	linkml:description "Elements this schema adds from the CNCF TAG-Security Secure Software Factory reference architecture and the OpenSSF supply-chain projects. They are not part of the SLSA specification." .
<https://w3id.org/lmodel/slsa/slsa_version> a linkml:SlotDefinition ;
	skos:altLabel "slsaVersion" ;
	linkml:description "The SLSA specification version the verifier applied, as MAJOR.MINOR." ;
	linkml:pattern "^[0-9]+\\.[0-9]+$" .
<https://w3id.org/lmodel/slsa/sm3> a linkml:SlotDefinition ;
	linkml:any_of _:c14n53 ;
	linkml:description "The SM3 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sm3"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/source_control_systems> a linkml:SlotDefinition ;
	linkml:description "The source control systems." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaSourceControlSystem> .
<https://w3id.org/lmodel/slsa/source_level> a linkml:SlotDefinition ;
	linkml:description "The SLSA Source level the SCS asserts for the revision." ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaSourceLevel> .
<https://w3id.org/lmodel/slsa/source_repositories> a linkml:SlotDefinition ;
	linkml:description "The source repositories." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaSourceRepository> .
<https://w3id.org/lmodel/slsa/source_revisions> a linkml:SlotDefinition ;
	linkml:description "The source revisions." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaSourceRevision> .
<https://w3id.org/lmodel/slsa/sparqlpath> dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
	linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/started_on> a linkml:SlotDefinition ;
	skos:altLabel "startedOn" ;
	skos:closeMatch "spdx_build:buildStartTime"^^xsd:anyURI ;
	linkml:description "When the build started." ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_timestamp> .
<https://w3id.org/lmodel/slsa/statement_type> a linkml:SlotDefinition ;
	skos:altLabel "_type" ;
	linkml:description "The in-toto statement type, always https://in-toto.io/Statement/v1." ;
	linkml:pattern "^https://in-toto\\.io/Statement/v1$" ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_type_uri> ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:statement_type"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/strategies> a linkml:SlotDefinition ;
	linkml:description "The strategy themes applied or recommended." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaAdoptionStrategy> .
<https://w3id.org/lmodel/slsa/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/subject> a linkml:SlotDefinition ;
	linkml:description "The artifacts the predicate is about, each with a digest." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoStatementSubject> ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:subject"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/time_verified> a linkml:SlotDefinition ;
	skos:altLabel "timeVerified" ;
	linkml:description "When the verification happened." ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_timestamp> .
<https://w3id.org/lmodel/slsa/transparency_log_entry> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_ssf> ;
	a linkml:SlotDefinition ;
	linkml:description "The transparency log entry that records the signature, such as a Rekor entry." ;
	linkml:range <https://w3id.org/lmodel/slsa/uri> .
<https://w3id.org/lmodel/slsa/uri> dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
	a linkml:TypeDefinition ;
	skos:closeMatch "schema:URL"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
	linkml:description "a complete URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/uriorcurie> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "URIorCURIE" ;
	linkml:definition_uri "https://w3id.org/linkml/Uriorcurie"^^xsd:anyURI ;
	linkml:description "a URI or a CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/value> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:hashValue"^^xsd:anyURI ;
	linkml:description "The digest under that algorithm, in the encoding the algorithm documents." ;
	linkml:pattern "^\\S+$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:value"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/verification_result> a linkml:SlotDefinition ;
	skos:altLabel "verificationResult" ;
	linkml:description "Whether the subject passed the policy." ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaVerificationResult> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/verified_level> a linkml:SlotDefinition ;
	linkml:description "The level the dependencies were verified at, or a result of the issuer's own." ;
	linkml:pattern "^(SLSA_BUILD_LEVEL_(UNEVALUATED|[0-3])|SLSA_SOURCE_LEVEL_(UNEVALUATED|[0-4])|SLSA_SOURCE_TWO_PARTY_REVIEWED|SLSA_BUILD_REPRODUCED|([!-RT-rt-~]|[Ss]$|[Ss][!-KM-km-~]|[Ss][Ll]$|[Ss][Ll][!-RT-rt-~]|[Ss][Ll][Ss]$|[Ss][Ll][Ss][!-@B-`b-~]|[Ss][Ll][Ss][Aa]$|[Ss][Ll][Ss][Aa][!-^`-~])[!-~]*)$" ;
	linkml:range <https://w3id.org/lmodel/slsa/slsa_result_value> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/verified_levels> a linkml:SlotDefinition ;
	skos:altLabel "verifiedLevels" ;
	skos:note "A VSA lists at most one level per track, and only FAILED when verification failed; the validator checks neither." ;
	linkml:description "The highest level verified in each track, any verified property, and any result of the issuer's own; a level implies the levels below it." ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:pattern "^(SLSA_BUILD_LEVEL_(UNEVALUATED|[0-3])|SLSA_SOURCE_LEVEL_(UNEVALUATED|[0-4])|SLSA_SOURCE_TWO_PARTY_REVIEWED|SLSA_BUILD_REPRODUCED|([!-RT-rt-~]|[Ss]$|[Ss][!-KM-km-~]|[Ss][Ll]$|[Ss][Ll][!-RT-rt-~]|[Ss][Ll][Ss]$|[Ss][Ll][Ss][!-@B-`b-~]|[Ss][Ll][Ss][Aa]$|[Ss][Ll][Ss][Aa][!-^`-~])[!-~]*)$" ;
	linkml:range <https://w3id.org/lmodel/slsa/slsa_result_value> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/verifier> a linkml:SlotDefinition ;
	linkml:description "The verifier that made this determination." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaVerifier> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/verifier_id> a linkml:SlotDefinition ;
	skos:altLabel "id" ;
	linkml:description "The URI that identifies the verifier." ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_type_uri> ;
	linkml:required true .
_:c14n0 a linkml:AnonymousSlotExpression ;
	linkml:range <https://w3id.org/lmodel/slsa/string> .
_:c14n1 skos:example "S4" ;
	linkml:tag "study_theme"^^xsd:anyURI .
_:c14n101 a linkml:AnonymousClassExpression ;
	linkml:slot_conditions <https://w3id.org/lmodel/slsa/sha224> .
_:c14n103 a linkml:AnonymousSlotExpression ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoDigestSet> .
_:c14n105 a linkml:AnonymousSlotExpression ;
	linkml:range <https://w3id.org/lmodel/slsa/string> .
_:c14n107 a linkml:AnonymousClassExpression ;
	linkml:slot_conditions <https://w3id.org/lmodel/slsa/sha256> .
_:c14n108 a linkml:AnonymousSlotExpression ;
	linkml:range <https://w3id.org/lmodel/slsa/string> .
_:c14n11 a linkml:AnonymousClassExpression ;
	linkml:slot_conditions <https://w3id.org/lmodel/slsa/resource_uri> .
_:c14n110 a linkml:AnonymousClassExpression ;
	linkml:slot_conditions <https://w3id.org/lmodel/slsa/git_tree> .
_:c14n12 a linkml:AnonymousSlotExpression ;
	linkml:range <https://w3id.org/lmodel/slsa/string> .
_:c14n14 a linkml:AnonymousClassExpression ;
	linkml:slot_conditions <https://w3id.org/lmodel/slsa/sha3_256> .
