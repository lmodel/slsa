	skos:mappingRelation "https://w3id.org/lmodel/slsa/build_env_level"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/build_env_level"^^xsd:anyURI ;
	linkml:description "The SLSA Build Environment level this meets." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentAttestation> , <https://w3id.org/lmodel/slsa/SlsaBuildImage> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentAttestation> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/build_env_level"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/build_id> a linkml:SlotDefinition ;
	linkml:description "The immutable identifier of the build execution the environment was assigned to." ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/build_image> a linkml:SlotDefinition ;
	linkml:description "The image the environment was instantiated from." ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildImage> .
<https://w3id.org/lmodel/slsa/build_images> a linkml:SlotDefinition ;
	linkml:description "The build images." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildImage> .
<https://w3id.org/lmodel/slsa/build_level> a linkml:SlotDefinition ;
	linkml:description "The highest SLSA Build level the platform's provenance can meet." ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildLevel> .
<https://w3id.org/lmodel/slsa/build_metadata> a linkml:SlotDefinition ;
	skos:altLabel "metadata" ;
	linkml:description "Metadata about this execution of the build." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildMetadata> .
<https://w3id.org/lmodel/slsa/build_platform> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_build_track> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/slsa/build_platform"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/build_platform"^^xsd:anyURI ;
	linkml:description "The build platform this party or component belongs to or uses." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaControlPlane> , <https://w3id.org/lmodel/slsa/SlsaProducer> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaControlPlane> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildPlatform> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/build_platform"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/build_platforms> a linkml:SlotDefinition ;
	linkml:description "The build platforms." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildPlatform> .
<https://w3id.org/lmodel/slsa/build_type> a linkml:SlotDefinition ;
	skos:altLabel "buildType" ;
	skos:closeMatch "spdx_build:buildType"^^xsd:anyURI ;
	linkml:description "The URI of the template that says how to run the build and read its parameters and dependencies; required at Build L1." ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_type_uri> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/builder> a linkml:SlotDefinition ;
	linkml:description "The build platform that ran the build and is trusted to have written this provenance; required at Build L1." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildPlatform> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/builder_dependencies> a linkml:SlotDefinition ;
	skos:altLabel "builderDependencies" ;
	linkml:description "Dependencies of the platform's orchestrator that do not run inside the build but may affect provenance generation or its guarantees." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> .
<https://w3id.org/lmodel/slsa/builder_id> a linkml:SlotDefinition ;
	skos:altLabel "id" ;
	linkml:description "The URI that identifies the platform and determines its SLSA Build level." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_type_uri> .
<https://w3id.org/lmodel/slsa/byproducts> a linkml:SlotDefinition ;
	linkml:description "Artifacts the build produced beside its outputs that may help debugging or incident response, such as logs." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> .
<https://w3id.org/lmodel/slsa/challenges> a linkml:SlotDefinition ;
	linkml:description "The challenge themes that apply." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaAdoptionChallenge> .
<https://w3id.org/lmodel/slsa/component> a linkml:SlotDefinition ;
	linkml:description "The component's name." ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/component_version> a linkml:SlotDefinition ;
	linkml:description "The component's version string." .
<https://w3id.org/lmodel/slsa/component_versions> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_build_track> ;
	a linkml:SlotDefinition ;
	skos:altLabel "version" ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/slsa/component_versions"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/component_versions"^^xsd:anyURI ;
	linkml:description "The version of each named component of a platform." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaBuildPlatform> , <https://w3id.org/lmodel/slsa/SlsaVerifier> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaBuildPlatform> ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaComponentVersion> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/component_versions"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/content> a linkml:SlotDefinition ;
	skos:note "The in-toto framework asks for content under 1 KB, so that attestations stay small." ;
	linkml:any_of _:c14n15 ;
	linkml:description "The resource's content itself, base64-encoded, for a resource small enough to carry inline." ;
	linkml:pattern "^[A-Za-z0-9+/_-]+={0,2}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:content"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/control_planes> a linkml:SlotDefinition ;
	linkml:description "The control planes of the build platforms." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaControlPlane> .
<https://w3id.org/lmodel/slsa/controls_enforced> a linkml:SlotDefinition ;
	skos:note "Two-party review is a control many single-maintainer projects cannot meet (Tamanna et al., 2024, LF.2)." ;
	linkml:description "The technical controls the SCS enforced when the revision was created, as the organization documents them." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/slsa/curie> dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations this MUST be expanded to a URI" , "in non-RDF serializations MAY be serialized as the compact representation" ;
	linkml:base "Curie" ;
	linkml:definition_uri "https://w3id.org/linkml/Curie"^^xsd:anyURI ;
	linkml:description "a compact URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/date> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"." , "URI is dateTime because OWL reasoners don't work with straight date or time" ;
	skos:exactMatch "schema:Date"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDate" ;
	linkml:definition_uri "https://w3id.org/linkml/Date"^^xsd:anyURI ;
	linkml:description "a date (year, month and day) in an idealized calendar" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#date"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/date_or_datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI ;
	linkml:description "Either a date or a datetime" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"." ;
	skos:exactMatch "schema:DateTime"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDateTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Datetime"^^xsd:anyURI ;
	linkml:description "The combination of a date and time" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/decimal> a linkml:TypeDefinition ;
	skos:broadMatch "schema:Number"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Decimal" ;
	linkml:definition_uri "https://w3id.org/linkml/Decimal"^^xsd:anyURI ;
	linkml:description "A real number with arbitrary precision that conforms to the xsd:decimal specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#decimal"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/dependencies> a linkml:SlotDefinition ;
	linkml:description "The dependencies, each as a resource descriptor." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> .
<https://w3id.org/lmodel/slsa/dependency_count> a linkml:SlotDefinition ;
	linkml:description "How many dependencies were verified at that level." ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/slsa/integer> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/dependency_inventories> a linkml:SlotDefinition ;
	linkml:description "The dependency inventories." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaDependencyInventory> .
<https://w3id.org/lmodel/slsa/dependency_level> a linkml:SlotDefinition ;
	linkml:description "The SLSA Dependency level the producer's process meets for this artifact." ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaDependencyLevel> .
<https://w3id.org/lmodel/slsa/dependency_levels> a linkml:SlotDefinition ;
	skos:altLabel "dependencyLevels" ;
	skos:note "The attestation's JSON tells an empty map (no dependencies) from an absent one (no claim); this list cannot, so an empty list reads as no claim." ;
	linkml:description "How many transitive dependencies were verified at each level; absent when the verifier makes no claim about dependencies." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaDependencyLevelCount> .
<https://w3id.org/lmodel/slsa/digest> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/digest"^^xsd:anyURI ;
	linkml:any_of _:c14n103 ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/digest"^^xsd:anyURI ;
	linkml:description "The cryptographic digests of a resource's content, keyed by algorithm." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> , <https://w3id.org/lmodel/slsa/SlsaMeasurement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> ;
	linkml:range <https://w3id.org/lmodel/slsa/InTotoDigestSet> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/digest"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/dir_hash> a linkml:SlotDefinition ;
	skos:altLabel "dirHash" ;
	linkml:any_of _:c14n72 ;
	linkml:description "A digest over a directory's content by the dirhash Hash1 function, in lowercase hexadecimal rather than base64." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:dir_hash"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/double> a linkml:TypeDefinition ;
	skos:closeMatch "schema:Float"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Double"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:double specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/download_location> a linkml:SlotDefinition ;
	skos:altLabel "downloadLocation" ;
	skos:closeMatch "dcat:downloadURL"^^xsd:anyURI , "spdx_software:downloadLocation"^^xsd:anyURI ;
	linkml:description "Where the resource can be fetched, when that differs from its identifying URI." ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_resource_uri> ;
	linkml:slot_uri "in_toto_linkml:download_location"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/ecosystem> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_build_track> , <https://w3id.org/lmodel/slsa/slsa_dependency_track> ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/slsa/slsa_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/slsa/ecosystem"^^xsd:anyURI ;
	skos:note "One ecosystem's tools can name the same package differently, which the study found affects attestations and provenance, so verifiers match provenance to package names with care (Tamanna et al., 2024, UR.1)." ;
	linkml:definition_uri "https://w3id.org/lmodel/slsa/ecosystem"^^xsd:anyURI ;
	linkml:description "The package ecosystem whose rules govern how a package is named and distributed, such as PyPA, npm or OCI." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/SlsaPackage> , <https://w3id.org/lmodel/slsa/SlsaPackageRegistry> ;
	linkml:owner <https://w3id.org/lmodel/slsa/SlsaPackage> ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/slsa/ecosystem"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/external_parameters> a linkml:SlotDefinition ;
	skos:altLabel "externalParameters" ;
	skos:broadMatch "spdx_build:parameter"^^xsd:anyURI ;
	skos:note "SPDX's configSource fields name the three parts of SLSA 0.2's configSource, which SLSA 1.0 records as external parameters for its entry point and URI, and as a resolved dependency for its URI and digest." , "Verifiers reject parameters they do not recognize here." ;
	skos:relatedMatch "spdx_build:configSourceEntrypoint"^^xsd:anyURI , "spdx_build:configSourceUri"^^xsd:anyURI ;
	linkml:description "The inputs under the tenant's control; required at Build L1, complete at Build L3 and verified by consumers." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaBuildParameter> ;
	linkml:required true .
<https://w3id.org/lmodel/slsa/finished_on> a linkml:SlotDefinition ;
	skos:altLabel "finishedOn" ;
	skos:closeMatch "spdx_build:buildEndTime"^^xsd:anyURI ;
	linkml:description "When the build finished." ;
	linkml:range <https://w3id.org/lmodel/slsa/in_toto_timestamp> .
<https://w3id.org/lmodel/slsa/float> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"." ;
	skos:exactMatch "schema:Float"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Float"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:float specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#float"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/git_blob> a linkml:SlotDefinition ;
	skos:altLabel "gitBlob" ;
	linkml:any_of _:c14n73 ;
	linkml:description "The git blob id of a file's content." ;
	linkml:pattern "^[a-f0-9]{40}([a-f0-9]{24})?$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:git_blob"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/git_commit> a linkml:SlotDefinition ;
	skos:altLabel "gitCommit" ;
	linkml:any_of _:c14n76 ;
	linkml:description "The git commit id of a source revision." ;
	linkml:pattern "^[a-f0-9]{40}([a-f0-9]{24})?$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:git_commit"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/git_tag> a linkml:SlotDefinition ;
	skos:altLabel "gitTag" ;
	linkml:any_of _:c14n46 ;
	linkml:description "The git object id of an annotated tag." ;
	linkml:pattern "^[a-f0-9]{40}([a-f0-9]{24})?$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:git_tag"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/git_tree> a linkml:SlotDefinition ;
	skos:altLabel "gitTree" ;
	linkml:any_of _:c14n34 ;
	linkml:description "The git tree id of a source revision's content, or of any file tree." ;
	linkml:pattern "^[a-f0-9]{40}([a-f0-9]{24})?$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:git_tree"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/gost> a linkml:SlotDefinition ;
	linkml:any_of _:c14n74 ;
	linkml:description "The GOST R 34.11 digest of the artifact, of 256 or 512 bits." ;
	linkml:pattern "^[a-f0-9]{64}([a-f0-9]{64})?$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:gost"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/guac_uri> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_ssf> ;
	a linkml:SlotDefinition ;
	linkml:description "Where a GUAC instance answers queries about the package's dependency and provenance graph." ;
	linkml:range <https://w3id.org/lmodel/slsa/uri> .
<https://w3id.org/lmodel/slsa/hermetic> OIO:inSubset <https://w3id.org/lmodel/slsa/slsa_adoption_study> ;
	a linkml:SlotDefinition ;
	skos:note "SLSA v1.2 does not require hermetic builds; Build L3's isolation is a different property, and hermeticity is a candidate for a future Build L4." , "The study cites a 2023 industry survey in which over half the participants found hermetic builds hard to implement, and lists \"hermetic build\" among SLSA's unclear terms (Tamanna et al., 2024, UC.1)." ;
	linkml:description "Whether the build could reach only the dependencies it declared, with no other network or filesystem access." ;
	linkml:range <https://w3id.org/lmodel/slsa/boolean> .
<https://w3id.org/lmodel/slsa/hosted> a linkml:SlotDefinition ;
	skos:note "Build L2 and above require a hosted platform." ;
	linkml:description "Whether the platform is a hosted service on shared or dedicated infrastructure rather than an individual's workstation." ;
	linkml:range <https://w3id.org/lmodel/slsa/boolean> .
<https://w3id.org/lmodel/slsa/hosted_by> a linkml:SlotDefinition ;
	linkml:description "The source control system that hosts the repository." ;
	linkml:range <https://w3id.org/lmodel/slsa/SlsaSourceControlSystem> .
<https://w3id.org/lmodel/slsa/image_uri> a linkml:SlotDefinition ;
	linkml:description "The URI that identifies the image version, such as an OCI reference with its digest." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/slsa/uri> .
<https://w3id.org/lmodel/slsa/inTotoAdditionalDigest__algorithm> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "http://spdx.org/rdf/terms#algorithm"^^xsd:anyURI ;
	skos:note "A name starts with a lowercase letter, as the framework's own names do, so that SHA256 is not taken for sha256, and it may hold a colon, as go-witness's gitoid:sha256 does. The framework itself sets no rule for other names." , "An algorithm that InTotoDigestSet names, by its JSON key or by its field name, goes in that field instead." ;
	skos:prefLabel "algorithm" ;
	linkml:description "The algorithm's name, as the key the attestation's JSON uses, such as svn_revision_id." ;
	linkml:domain_of <https://w3id.org/lmodel/slsa/InTotoAdditionalDigest> ;
	linkml:none_of _:c14n18 ;
	linkml:owner <https://w3id.org/lmodel/slsa/InTotoAdditionalDigest> ;
	linkml:pattern "^[a-z][A-Za-z0-9_.:-]*$" ;
	linkml:range <https://w3id.org/lmodel/slsa/string> ;
	linkml:required true ;
	linkml:slot_uri "http://spdx.org/rdf/terms#algorithm"^^xsd:anyURI .
<https://w3id.org/lmodel/slsa/inTotoAdditionalDigest__value> a linkml:SlotDefinition ;
