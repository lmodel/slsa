<https://w3id.org/lmodel/slsa/slsa> dcterms:license "Apache-2.0" ;
	dcterms:source "https://slsa.dev/spec/v1.2"^^xsd:anyURI ;
	dcterms:title "Supply-chain Levels for Software Artifacts (SLSA)" ;
	pav:version "1.2.0" ;
	schema1:inLanguage "en" ;
	schema1:keywords "SLSA" , "build provenance" , "in-toto" , "software supply chain" , "supply chain security" , "verification summary" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://github.com/slsa-framework/slsa"^^xsd:anyURI , "https://lmodel.github.io/slsa"^^xsd:anyURI , "https://slsa.dev/spec/v1.2/"^^xsd:anyURI ;
	skos:note "The version is the SLSA specification version the model renders. The Dependency and Build Environment tracks follow the working draft at that version, which the release does not include." , "slsa_core imports only the LinkML types, each track module imports the core, and this file adds only the document root, so an importer can take one module." ;
	sh:declare _:c14n88 , _:c14n98 ;
	linkml:classes <https://w3id.org/lmodel/slsa/InTotoAdditionalDigest> , <https://w3id.org/lmodel/slsa/InTotoAnnotation> , <https://w3id.org/lmodel/slsa/InTotoDigestSet> , <https://w3id.org/lmodel/slsa/InTotoPredicate> , <https://w3id.org/lmodel/slsa/InTotoResourceDescriptor> , <https://w3id.org/lmodel/slsa/InTotoStatement> , <https://w3id.org/lmodel/slsa/InTotoStatementSubject> , <https://w3id.org/lmodel/slsa/SlsaAdoptionMetadata> , <https://w3id.org/lmodel/slsa/SlsaBranch> , <https://w3id.org/lmodel/slsa/SlsaBuildDefinition> , <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentAttestation> , <https://w3id.org/lmodel/slsa/SlsaBuildImage> , <https://w3id.org/lmodel/slsa/SlsaBuildImageProducer> , <https://w3id.org/lmodel/slsa/SlsaBuildMetadata> , <https://w3id.org/lmodel/slsa/SlsaBuildParameter> , <https://w3id.org/lmodel/slsa/SlsaBuildPlatform> , <https://w3id.org/lmodel/slsa/SlsaBuildProvenance> , <https://w3id.org/lmodel/slsa/SlsaComponentVersion> , <https://w3id.org/lmodel/slsa/SlsaConsumer> , <https://w3id.org/lmodel/slsa/SlsaControlPlane> , <https://w3id.org/lmodel/slsa/SlsaDependencyInventory> , <https://w3id.org/lmodel/slsa/SlsaDependencyLevelCount> , <https://w3id.org/lmodel/slsa/SlsaDocument> , <https://w3id.org/lmodel/slsa/SlsaInfrastructureProvider> , <https://w3id.org/lmodel/slsa/SlsaMeasurement> , <https://w3id.org/lmodel/slsa/SlsaNamedReference> , <https://w3id.org/lmodel/slsa/SlsaPackage> , <https://w3id.org/lmodel/slsa/SlsaPackageRegistry> , <https://w3id.org/lmodel/slsa/SlsaParty> , <https://w3id.org/lmodel/slsa/SlsaPredicate> , <https://w3id.org/lmodel/slsa/SlsaProducer> , <https://w3id.org/lmodel/slsa/SlsaRunDetails> , <https://w3id.org/lmodel/slsa/SlsaSourceControlSystem> , <https://w3id.org/lmodel/slsa/SlsaSourceProvenance> , <https://w3id.org/lmodel/slsa/SlsaSourceRepository> , <https://w3id.org/lmodel/slsa/SlsaSourceRevision> , <https://w3id.org/lmodel/slsa/SlsaStatement> , <https://w3id.org/lmodel/slsa/SlsaTag> , <https://w3id.org/lmodel/slsa/SlsaVerificationSummary> , <https://w3id.org/lmodel/slsa/SlsaVerificationSummaryInputAttestation> , <https://w3id.org/lmodel/slsa/SlsaVerificationSummaryPolicy> , <https://w3id.org/lmodel/slsa/SlsaVerifier> ;
	linkml:default_prefix "slsa" ;
	linkml:default_range <https://w3id.org/lmodel/slsa/string> ;
	linkml:description "A LinkML model of the SLSA specification: its tracks and levels, the roles and systems in a software supply chain, and the in-toto attestations that carry build provenance and verification summaries." ;
	linkml:enums <https://w3id.org/lmodel/slsa/SlsaAdoptionChallenge> , <https://w3id.org/lmodel/slsa/SlsaAdoptionStrategy> , <https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentLevel> , <https://w3id.org/lmodel/slsa/SlsaBuildLevel> , <https://w3id.org/lmodel/slsa/SlsaDependencyLevel> , <https://w3id.org/lmodel/slsa/SlsaResult> , <https://w3id.org/lmodel/slsa/SlsaReviewType> , <https://w3id.org/lmodel/slsa/SlsaSourceLevel> , <https://w3id.org/lmodel/slsa/SlsaVerificationResult> ;
	linkml:id "https://w3id.org/lmodel/slsa"^^xsd:anyURI ;
