      ],
      "is_a": "SlsaPredicate",
      "slots": [
        "slsaPredicate__predicate_kind",
        "build_env_level",
        "slsaBuildEnvironmentAttestation__build_id",
        "slsaBuildEnvironmentAttestation__build_image",
        "slsaBuildEnvironmentAttestation__measurements"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "build_id",
          "description": "The immutable identifier of the build execution the environment was assigned to.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "build_image",
          "description": "The image the environment was instantiated from.",
          "range": "SlsaBuildImage",
          "@type": "SlotDefinition"
        },
        {
          "name": "measurements",
          "description": "The measurements of the environment's components taken during boot.",
          "range": "SlsaMeasurement",
