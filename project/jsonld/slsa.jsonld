      "domain_of": [
        "SlsaVerificationSummary"
      ],
      "range": "SlsaResult",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "slsaVerificationSummary__organization_properties",
      "description": "Properties an organization defines for its own consumers, each prefixed ORG_SOURCE_.",
      "in_subset": [
        "slsa_source_track"
      ],
      "from_schema": "https://w3id.org/lmodel/slsa/slsa_verification",
      "slot_uri": "https://w3id.org/lmodel/slsa/organization_properties",
      "alias": "organization_properties",
      "owner": "SlsaVerificationSummary",
      "domain_of": [
        "SlsaVerificationSummary"
      ],
      "range": "string",
      "multivalued": true,
      "pattern": "^ORG_SOURCE_",
      "@type": "SlotDefinition"
    },
    {
      "name": "slsaVerificationSummary__dependency_levels",
      "description": "How many transitive dependencies were verified at each level; absent when the verifier makes no claim about dependencies.",
      "from_schema": "https://w3id.org/lmodel/slsa/slsa_verification",
      "slot_uri": "https://w3id.org/lmodel/slsa/dependency_levels",
