    },
    {
      "name": "SlsaBuildEnvironmentAttestation",
      "definition_uri": "https://w3id.org/lmodel/slsa/SlsaBuildEnvironmentAttestation",
      "description": "Evidence of the state of a build environment when a build was dispatched to it: the image it came from and the measurements taken at boot.",
      "comments": [
        "The track names no single predicate type; platforms issue this evidence in formats such as SCAI or a VSA."
      ],
      "in_subset": [
        "slsa_build_environment_track"
      ],
      "from_schema": "https://w3id.org/lmodel/slsa/slsa_build_environment",
