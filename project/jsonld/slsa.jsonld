      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "slsaVerificationSummary__verification_result",
      "description": "Whether the subject passed the policy.",
      "from_schema": "https://w3id.org/lmodel/slsa/slsa_verification",
      "slot_uri": "https://w3id.org/lmodel/slsa/verification_result",
      "alias": "verification_result",
