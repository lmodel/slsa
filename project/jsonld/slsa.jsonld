      "slot_uri": "https://w3id.org/lmodel/slsa/policy",
      "alias": "policy",
      "owner": "SlsaVerificationSummary",
      "domain_of": [
        "SlsaVerificationSummary"
      ],
      "range": "InTotoResourceDescriptor",
      "required": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "slsaVerificationSummary__input_attestations",
      "description": "Every attestation the verifier consulted, each with a digest; complete when present.",
      "from_schema": "https://w3id.org/lmodel/slsa/slsa_verification",
      "slot_uri": "https://w3id.org/lmodel/slsa/input_attestations",
      "alias": "input_attestations",
