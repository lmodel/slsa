@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix slsa: <https://w3id.org/lmodel/slsa/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
xsd:dateTime a rdfs:Datatype ;
	owl:equivalentClass _:c14n502 .
<https://w3id.org/lmodel/in-toto/InTotoAdditionalDigest> a owl:Class ;
	rdfs:label "InTotoAdditionalDigest" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md> ;
	rdfs:subClassOf _:c14n339 , _:c14n39 , _:c14n491 , _:c14n510 , _:c14n58 , _:c14n76 ;
	skos:definition "One digest under an algorithm that InTotoDigestSet does not name, such as an SCS's own revision type." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "An SCS that does not use cryptographic digests defines a canonical revision type of its own that includes the repository, such as svn_revision_id." , "Each algorithm appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." , "In the attestation's JSON the algorithm is a key of the digest set beside the named ones, and an algorithm the framework does not define documents how its value is encoded." .
<https://w3id.org/lmodel/in-toto/InTotoAnnotation> a owl:Class ;
	rdfs:label "InTotoAnnotation" ;
	rdfs:subClassOf _:c14n202 , _:c14n229 , _:c14n397 , _:c14n398 , _:c14n57 ;
	skos:definition "One vendor-specific annotation on a resource descriptor: a key and its values." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "Each key appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." , "The attestation's JSON allows any JSON value. A string becomes one value and an array one value per item; any other value or item is written as its JSON text, so one value cannot tell a string from a one-item array." .
<https://w3id.org/lmodel/in-toto/InTotoDigestSet> a owl:Class ;
	rdfs:label "InTotoDigestSet" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md> ;
	rdfs:subClassOf _:c14n101 , _:c14n108 , _:c14n130 , _:c14n132 , _:c14n133 , _:c14n157 , _:c14n158 , _:c14n165 , _:c14n178 , _:c14n191 , _:c14n20 , _:c14n208 , _:c14n211 , _:c14n213 , _:c14n223 , _:c14n233 , _:c14n235 , _:c14n244 , _:c14n249 , _:c14n258 , _:c14n28 , _:c14n283 , _:c14n302 , _:c14n304 , _:c14n306 , _:c14n309 , _:c14n311 , _:c14n312 , _:c14n317 , _:c14n326 , _:c14n328 , _:c14n331 , _:c14n335 , _:c14n345 , _:c14n355 , _:c14n36 , _:c14n360 , _:c14n369 , _:c14n373 , _:c14n391 , _:c14n395 , _:c14n40 , _:c14n405 , _:c14n410 , _:c14n412 , _:c14n416 , _:c14n432 , _:c14n439 , _:c14n446 , _:c14n45 , _:c14n455 , _:c14n46 , _:c14n471 , _:c14n473 , _:c14n476 , _:c14n479 , _:c14n487 , _:c14n488 , _:c14n49 , _:c14n493 , _:c14n508 , _:c14n517 , _:c14n521 , _:c14n524 , _:c14n532 , _:c14n533 , _:c14n540 , _:c14n549 , _:c14n550 , _:c14n6 , _:c14n63 , _:c14n69 , _:c14n83 , _:c14n84 , _:c14n90 ;
	skos:definition "A set of one or more digests over one artifact, keyed by algorithm, from which a consumer picks the algorithm it trusts." ;
	skos:editorialNote "Each condition in any_of names its range through a nested any_of, because the JSON Schema generator leaves a condition's own range out, and a null value would then count as present." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "A consumer accepts only the algorithms it considers secure and ignores the rest, and two sets match when any accepted algorithm matches." , "SHAKE and BLAKE2 digests can be of any length, and this schema asks for at least 32 bytes, since a shorter digest resists collisions too weakly to identify an artifact." , "The named algorithms take lowercase hexadecimal, and additional_digests holds any other algorithm, such as an SCS's own revision type." .
<https://w3id.org/lmodel/in-toto/InTotoPredicate> a owl:Class ;
	rdfs:label "InTotoPredicate" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/predicate.md> ;
	rdfs:subClassOf slsa:SlsaPredicate , _:c14n215 , _:c14n26 , _:c14n98 ;
	skos:definition "The base of every predicate an in-toto statement can carry; predicate_kind names the concrete kind." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "The statement's predicate_type names the predicate's type by URI, and each concrete class says which URI it renders. Nothing ties the two, since a schema that imports this module may model a predicate under its own URI." .
<https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> a owl:Class ;
	rdfs:label "InTotoResourceDescriptor" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/resource_descriptor.md> ;
	rdfs:subClassOf _:c14n102 , _:c14n106 , _:c14n117 , _:c14n141 , _:c14n16 , _:c14n164 , _:c14n174 , _:c14n199 , _:c14n250 , _:c14n294 , _:c14n333 , _:c14n346 , _:c14n389 , _:c14n42 , _:c14n421 , _:c14n454 , _:c14n496 , _:c14n504 , _:c14n53 , _:c14n54 , _:c14n97 ;
	skos:definition "A reference to a software artifact or other resource by URI or digest, or the resource itself as content, with optional metadata." ;
	skos:editorialNote "Each condition in any_of names its range through a nested any_of, because the JSON Schema generator leaves a condition's own range out, and a null value would then count as present." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "A descriptor carries at least one of a URI, a digest or its content; a field that needs a particular one says so." .
<https://w3id.org/lmodel/in-toto/InTotoResourceUri> a rdfs:Datatype ;
	owl:equivalentClass _:c14n441 .
<https://w3id.org/lmodel/in-toto/InTotoStatement> a owl:Class ;
	rdfs:label "InTotoStatement" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/statement.md> ;
	rdfs:subClassOf _:c14n15 , _:c14n168 , _:c14n186 , _:c14n2 , _:c14n212 , _:c14n242 , _:c14n252 , _:c14n295 , _:c14n321 , _:c14n359 , _:c14n384 ;
	skos:definition "The statement layer of an in-toto attestation: the subjects it is about, the type of its predicate and the predicate itself." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "A statement is the attestation, and its predicate is one kind of claim about the subjects, such as a test result or build provenance." , "The signature envelope around a statement, and the bundle that collects signed statements, are outside this model." .
<https://w3id.org/lmodel/in-toto/InTotoStatementSubject> a owl:Class ;
	rdfs:label "InTotoStatementSubject" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/statement.md> ;
	rdfs:subClassOf <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> , _:c14n225 , _:c14n353 , _:c14n434 ;
	skos:definition "One artifact an in-toto statement is about: a resource descriptor that carries a digest." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/InTotoTypeUri> a rdfs:Datatype ;
	owl:equivalentClass _:c14n176 .
<https://w3id.org/lmodel/in-toto/additional_digests> a owl:ObjectProperty ;
	rdfs:label "additional_digests" ;
	skos:definition "The digests under algorithms this class does not name." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/algorithm> a owl:DatatypeProperty ;
	rdfs:label "algorithm" ;
	skos:definition "The algorithm's name, as the key the attestation's JSON uses, such as svn_revision_id." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "A name starts with a lowercase letter, as the framework's own names do, so that SHA256 is not taken for sha256, and it may hold a colon, as go-witness's gitoid:sha256 does. The framework itself sets no rule for other names." , "An algorithm that InTotoDigestSet names, by its JSON key or by its field name, goes in that field instead." .
<https://w3id.org/lmodel/in-toto/annotation_key> a owl:DatatypeProperty ;
	rdfs:label "annotation_key" ;
	skos:definition "The annotation's key." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/annotation_values> a owl:DatatypeProperty ;
	rdfs:label "annotation_values" ;
	skos:definition "The annotation's values." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/annotations> a owl:ObjectProperty ;
	rdfs:label "annotations" ;
	skos:definition "Vendor-specific annotations on the resource, such as the source references a SLSA Source Verification Summary records." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/blake2b> a owl:DatatypeProperty ;
	rdfs:label "blake2b" ;
	skos:definition "The BLAKE2b digest of the artifact, of 32 to 64 bytes." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/blake2s> a owl:DatatypeProperty ;
	rdfs:label "blake2s" ;
	skos:definition "The BLAKE2s digest of the artifact, at its full 32 bytes." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/content> a owl:DatatypeProperty ;
	rdfs:label "content" ;
	skos:definition "The resource's content itself, base64-encoded, for a resource small enough to carry inline." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "The in-toto framework asks for content under 1 KB, so that attestations stay small." .
<https://w3id.org/lmodel/in-toto/digest> a owl:ObjectProperty ;
	rdfs:label "digest" ;
	rdfs:range <https://w3id.org/lmodel/in-toto/InTotoDigestSet> ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md> ;
	skos:definition "The cryptographic digests of a resource's content, keyed by algorithm." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/dir_hash> a owl:DatatypeProperty ;
	rdfs:label "dir_hash" ;
	skos:definition "A digest over a directory's content by the dirhash Hash1 function, in lowercase hexadecimal rather than base64." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/download_location> a owl:DatatypeProperty ;
	rdfs:label "download_location" ;
	skos:definition "Where the resource can be fetched, when that differs from its identifying URI." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/git_blob> a owl:DatatypeProperty ;
	rdfs:label "git_blob" ;
	skos:definition "The git blob id of a file's content." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/git_commit> a owl:DatatypeProperty ;
	rdfs:label "git_commit" ;
	skos:definition "The git commit id of a source revision." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/git_tag> a owl:DatatypeProperty ;
	rdfs:label "git_tag" ;
	skos:definition "The git object id of an annotated tag." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/git_tree> a owl:DatatypeProperty ;
	rdfs:label "git_tree" ;
	skos:definition "The git tree id of a source revision's content, or of any file tree." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/gost> a owl:DatatypeProperty ;
	rdfs:label "gost" ;
	skos:definition "The GOST R 34.11 digest of the artifact, of 256 or 512 bits." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/md5> a owl:DatatypeProperty ;
	rdfs:label "md5" ;
	skos:definition "The MD5 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "MD5 lacks collision resistance, so most consumers should not accept it." .
<https://w3id.org/lmodel/in-toto/media_type> a owl:DatatypeProperty ;
	rdfs:label "media_type" ;
	skos:definition "The IANA media type of the resource's content." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/predicate> a owl:ObjectProperty ;
	rdfs:label "predicate" ;
	rdfs:range <https://w3id.org/lmodel/in-toto/InTotoPredicate> ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/statement.md> ;
	skos:definition "The predicate, one of the kinds this schema or an importing one models; predicate_kind names which. Unset means the same as empty." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "It is a slot of its own rather than an attribute of InTotoStatement, because LOKF's predicate is a relation's type: `lokf adapt` renames a slot whose name LOKF defines and keeps its IRI, so a copy beside LOKF calls it in_toto_linkml_predicate." .
<https://w3id.org/lmodel/in-toto/predicate_kind> a owl:DatatypeProperty ;
	rdfs:label "predicate_kind" ;
	skos:definition "The kind of predicate, one of this class's descendants." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/predicate_type> a owl:DatatypeProperty ;
	rdfs:label "predicate_type" ;
	skos:definition "The URI that names the predicate's type and so its schema, such as https://in-toto.io/attestation/test-result/v0.1." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/resource_name> a owl:DatatypeProperty ;
	rdfs:label "resource_name" ;
	skos:definition "A name for the resource within the attestation that carries it." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/resource_uri> a owl:DatatypeProperty ;
	rdfs:label "resource_uri" ;
	rdfs:range <https://w3id.org/lmodel/in-toto/InTotoResourceUri> ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#resourceuri> ;
	skos:definition "The URI that identifies a resource, such as a package URL, a git repository address or an OCI image reference." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/ripemd160> a owl:DatatypeProperty ;
	rdfs:label "ripemd160" ;
	skos:definition "The RIPEMD-160 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha1> a owl:DatatypeProperty ;
	rdfs:label "sha1" ;
	skos:definition "The SHA-1 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> ;
	skos:note "SHA-1 lacks collision resistance, so most consumers should not rely on it." .
<https://w3id.org/lmodel/in-toto/sha224> a owl:DatatypeProperty ;
	rdfs:label "sha224" ;
	skos:definition "The SHA-224 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha256> a owl:DatatypeProperty ;
	rdfs:label "sha256" ;
	skos:definition "The SHA-256 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha384> a owl:DatatypeProperty ;
	rdfs:label "sha384" ;
	skos:definition "The SHA-384 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha3_224> a owl:DatatypeProperty ;
	rdfs:label "sha3_224" ;
	skos:definition "The SHA3-224 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha3_256> a owl:DatatypeProperty ;
	rdfs:label "sha3_256" ;
	skos:definition "The SHA3-256 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha3_384> a owl:DatatypeProperty ;
	rdfs:label "sha3_384" ;
	skos:definition "The SHA3-384 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha3_512> a owl:DatatypeProperty ;
	rdfs:label "sha3_512" ;
	skos:definition "The SHA3-512 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha512> a owl:DatatypeProperty ;
	rdfs:label "sha512" ;
	skos:definition "The SHA-512 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha512_224> a owl:DatatypeProperty ;
	rdfs:label "sha512_224" ;
	skos:definition "The SHA-512/224 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sha512_256> a owl:DatatypeProperty ;
	rdfs:label "sha512_256" ;
	skos:definition "The SHA-512/256 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/shake128> a owl:DatatypeProperty ;
	rdfs:label "shake128" ;
	skos:definition "The SHAKE128 digest of the artifact, of at least 32 bytes." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/shake256> a owl:DatatypeProperty ;
	rdfs:label "shake256" ;
	skos:definition "The SHAKE256 digest of the artifact, of at least 32 bytes." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/sm3> a owl:DatatypeProperty ;
	rdfs:label "sm3" ;
	skos:definition "The SM3 digest of the artifact." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/statement_type> a owl:DatatypeProperty ;
	rdfs:label "statement_type" ;
	skos:definition "The in-toto statement type, always https://in-toto.io/Statement/v1." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/subject> a owl:ObjectProperty ;
	rdfs:label "subject" ;
	skos:definition "The artifacts the predicate is about, each with a digest." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/in-toto/value> a owl:DatatypeProperty ;
	rdfs:label "value" ;
	skos:definition "The digest under that algorithm, in the encoding the algorithm documents." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto/in_toto_core> .
<https://w3id.org/lmodel/slsa.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://slsa.dev/spec/v1.2> ;
	dcterms:title "Supply-chain Levels for Software Artifacts (SLSA)" ;
	pav:version "1.2.0" ;
	a owl:Ontology ;
	rdfs:label "slsa" ;
	rdfs:seeAlso <https://github.com/slsa-framework/slsa> , <https://lmodel.github.io/slsa> , <https://slsa.dev/spec/v1.2/> ;
	skos:definition "A LinkML model of the SLSA specification: its tracks and levels, the roles and systems in a software supply chain, and the in-toto attestations that carry build provenance and verification summaries." ;
	skos:note "The version is the SLSA specification version the model renders. The Dependency and Build Environment tracks follow the working draft at that version, which the release does not include." , "slsa_core imports only the LinkML types, each track module imports the core, and this file adds only the document root, so an importer can take one module." .
slsa:SlsaAdoptionChallenge\#COMPLEX_IMPLEMENTATION a owl:Class ;
	rdfs:label "COMPLEX_IMPLEMENTATION" ;
	rdfs:subClassOf slsa:SlsaAdoptionChallenge ;
	skos:definition "Generating provenance and maintaining the required tools is complicated." ;
	skos:note "Sub-themes: complicated provenance generation (CI.1) and intricate tool maintenance (CI.2); 901 issues." ;
	slsa:study_theme "CI" .
slsa:SlsaAdoptionChallenge\#LIMITED_FEASIBILITY a owl:Class ;
	rdfs:label "LIMITED_FEASIBILITY" ;
	rdfs:subClassOf slsa:SlsaAdoptionChallenge ;
	skos:definition "Verification tooling, attestation storage and two-party review are hard to put into practice." ;
	skos:note "Sub-themes: limited attestation verification, including where attestations are stored (LF.1), and two-party review requirements, which projects with one maintainer find hard to meet (LF.2); 219 issues." ;
	slsa:study_theme "LF" .
slsa:SlsaAdoptionChallenge\#UNCLEAR_COMMUNICATION a owl:Class ;
	rdfs:label "UNCLEAR_COMMUNICATION" ;
	rdfs:subClassOf slsa:SlsaAdoptionChallenge ;
	skos:definition "SLSA's terms and its guidance for particular ecosystems are hard to understand." ;
	skos:note "Sub-themes: unclear definitions of key terms (UC.1) and unclear documentation, such as how to apply SLSA in an ecosystem (UC.2); 357 issues." ;
	slsa:study_theme "UC" .
slsa:SlsaAdoptionChallenge\#UNCLEAR_RELEVANCE a owl:Class ;
	rdfs:label "UNCLEAR_RELEVANCE" ;
	rdfs:subClassOf slsa:SlsaAdoptionChallenge ;
	skos:definition "Which attacks SLSA mitigates, and how it differs from other practices, is unclear." ;
	skos:note "Sub-theme: unclear relevance, including tools that name one package differently within an ecosystem (UR.1); 46 issues." ;
	slsa:study_theme "UR" .
slsa:SlsaAdoptionChallenge a owl:Class ;
	rdfs:label "SlsaAdoptionChallenge" ;
	rdfs:seeAlso <https://arxiv.org/abs/2409.05014> ;
	owl:unionOf _:c14n197 ;
	skos:definition "The four themes of difficulty practitioners met when adopting SLSA." ;
	skos:inScheme slsa:slsa_adoption ;
	linkml:permissible_values slsa:SlsaAdoptionChallenge\#COMPLEX_IMPLEMENTATION , slsa:SlsaAdoptionChallenge\#LIMITED_FEASIBILITY , slsa:SlsaAdoptionChallenge\#UNCLEAR_COMMUNICATION , slsa:SlsaAdoptionChallenge\#UNCLEAR_RELEVANCE .
slsa:SlsaAdoptionMetadata a owl:Class ;
	rdfs:label "SlsaAdoptionMetadata" ;
	rdfs:seeAlso <https://arxiv.org/abs/2409.05014> ;
	rdfs:subClassOf _:c14n24 , _:c14n287 , _:c14n32 , _:c14n509 ;
	skos:definition "The adoption challenges a deployment meets and the strategies it applies, from the study's taxonomy." ;
	skos:editorialNote "The study analysed 1,523 SLSA-related GitHub issues from 233 repositories and derived four challenge themes and five strategy themes." ;
	skos:inScheme slsa:slsa_adoption .
slsa:SlsaAdoptionStrategy\#COLLABORATE_WITH_COMMUNITY a owl:Class ;
	rdfs:label "COLLABORATE_WITH_COMMUNITY" ;
	rdfs:subClassOf slsa:SlsaAdoptionStrategy ;
	skos:definition "Align with industry standards, guide newcomers, and share knowledge across projects." ;
	slsa:study_theme "S5" .
slsa:SlsaAdoptionStrategy\#ENHANCE_ALIGNMENT_FLEXIBILITY a owl:Class ;
	rdfs:label "ENHANCE_ALIGNMENT_FLEXIBILITY" ;
	rdfs:subClassOf slsa:SlsaAdoptionStrategy ;
	skos:definition "Make SLSA fit more contexts, with build-system tracks, gamified levels, flexibility for varied organizations and alignment with OpenSSF practices." ;
	slsa:study_theme "S1" .
slsa:SlsaAdoptionStrategy\#IMPROVE_VERIFICATION_PROCESS a owl:Class ;
	rdfs:label "IMPROVE_VERIFICATION_PROCESS" ;
	rdfs:subClassOf slsa:SlsaAdoptionStrategy ;
	skos:definition "Strengthen verification and level determination, tag versions early, and give downstream users more signals." ;
	slsa:study_theme "S4" .
slsa:SlsaAdoptionStrategy\#PROVIDE_DETAILED_DOCUMENTATION a owl:Class ;
	rdfs:label "PROVIDE_DETAILED_DOCUMENTATION" ;
	rdfs:subClassOf slsa:SlsaAdoptionStrategy ;
	skos:definition "Give clearer definitions, standard terms, negative examples and better navigation." ;
	slsa:study_theme "S2" .
slsa:SlsaAdoptionStrategy\#STREAMLINE_PROVENANCE_GENERATION a owl:Class ;
	rdfs:label "STREAMLINE_PROVENANCE_GENERATION" ;
	rdfs:subClassOf slsa:SlsaAdoptionStrategy ;
	skos:definition "Simplify and standardize provenance generation with tools and templates, and fix release-tool inconsistencies." ;
	slsa:study_theme "S3" .
slsa:SlsaAdoptionStrategy a owl:Class ;
	rdfs:label "SlsaAdoptionStrategy" ;
	rdfs:seeAlso <https://arxiv.org/abs/2409.05014> ;
	owl:unionOf _:c14n290 ;
	skos:definition "The five themes of strategy practitioners proposed for the adoption challenges." ;
	skos:inScheme slsa:slsa_adoption ;
	linkml:permissible_values slsa:SlsaAdoptionStrategy\#COLLABORATE_WITH_COMMUNITY , slsa:SlsaAdoptionStrategy\#ENHANCE_ALIGNMENT_FLEXIBILITY , slsa:SlsaAdoptionStrategy\#IMPROVE_VERIFICATION_PROCESS , slsa:SlsaAdoptionStrategy\#PROVIDE_DETAILED_DOCUMENTATION , slsa:SlsaAdoptionStrategy\#STREAMLINE_PROVENANCE_GENERATION .
slsa:SlsaBranch a owl:Class ;
	rdfs:label "SlsaBranch" ;
	rdfs:subClassOf slsa:SlsaNamedReference ;
	skos:definition "A named reference that moves to track a line of development." ;
	skos:inScheme slsa:slsa_source .
slsa:SlsaBuildDefinition a owl:Class ;
	rdfs:label "SlsaBuildDefinition" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/build-provenance#builddefinition> ;
	rdfs:subClassOf _:c14n113 , _:c14n159 , _:c14n162 , _:c14n167 , _:c14n267 , _:c14n301 , _:c14n334 , _:c14n438 , _:c14n459 , _:c14n482 , _:c14n516 , _:c14n523 , _:c14n537 , _:c14n544 , _:c14n70 , _:c14n72 , _:c14n81 , _:c14n95 ;
	skos:definition "The inputs to a build, in enough detail to initialize it and begin execution; the builder vouches for their accuracy." ;
	skos:inScheme slsa:slsa_build .
slsa:SlsaBuildEnvironmentAttestation a owl:Class ;
	rdfs:label "SlsaBuildEnvironmentAttestation" ;
	rdfs:seeAlso <https://slsa.dev/spec/draft/build-env-track-basics#buildenv-levels> ;
	rdfs:subClassOf slsa:SlsaPredicate , _:c14n121 , _:c14n200 , _:c14n219 , _:c14n23 , _:c14n338 , _:c14n382 , _:c14n393 , _:c14n477 , _:c14n501 , _:c14n505 , _:c14n522 ;
	skos:definition "Evidence of the state of a build environment when a build was dispatched to it: the image it came from and the measurements taken at boot." ;
	skos:inScheme slsa:slsa_build_environment ;
	skos:note "The track names no single predicate type; platforms issue this evidence in formats such as SCAI or a VSA." .
slsa:SlsaBuildEnvironmentLevel\#SLSA_BUILD_ENV_LEVEL_0 a owl:Class ;
	rdfs:label "SLSA_BUILD_ENV_LEVEL_0" ;
	rdfs:subClassOf slsa:SlsaBuildEnvironmentLevel ;
	skos:definition "No Build Environment track claims." .
slsa:SlsaBuildEnvironmentLevel\#SLSA_BUILD_ENV_LEVEL_1 a owl:Class ;
	rdfs:label "SLSA_BUILD_ENV_LEVEL_1" ;
	rdfs:subClassOf slsa:SlsaBuildEnvironmentLevel ;
	skos:definition "The build image has signed build provenance, protecting against tampering while the image is distributed." .
slsa:SlsaBuildEnvironmentLevel\#SLSA_BUILD_ENV_LEVEL_2 a owl:Class ;
	rdfs:label "SLSA_BUILD_ENV_LEVEL_2" ;
	rdfs:subClassOf slsa:SlsaBuildEnvironmentLevel ;
	skos:definition "The compute platform attests to the environment's state at boot, protecting against tampering through the control plane." .
slsa:SlsaBuildEnvironmentLevel\#SLSA_BUILD_ENV_LEVEL_3 a owl:Class ;
	rdfs:label "SLSA_BUILD_ENV_LEVEL_3" ;
	rdfs:subClassOf slsa:SlsaBuildEnvironmentLevel ;
	skos:definition "Trusted hardware attests to the host's state, protecting against tampering through the host interface." .
slsa:SlsaBuildEnvironmentLevel a owl:Class ;
	rdfs:label "SlsaBuildEnvironmentLevel" ;
	rdfs:seeAlso <https://slsa.dev/spec/draft/build-env-track-basics#track-overview> ;
	owl:unionOf _:c14n315 ;
	skos:definition "The levels of the SLSA Build Environment track, each extending integrity further into the compute that runs builds." ;
	skos:inScheme slsa:slsa_build_environment ;
	linkml:permissible_values slsa:SlsaBuildEnvironmentLevel\#SLSA_BUILD_ENV_LEVEL_0 , slsa:SlsaBuildEnvironmentLevel\#SLSA_BUILD_ENV_LEVEL_1 , slsa:SlsaBuildEnvironmentLevel\#SLSA_BUILD_ENV_LEVEL_2 , slsa:SlsaBuildEnvironmentLevel\#SLSA_BUILD_ENV_LEVEL_3 .
slsa:SlsaBuildImage a owl:Class ;
	rdfs:label "SlsaBuildImage" ;
	rdfs:seeAlso <https://slsa.dev/spec/draft/build-env-track-basics#build-environment-model> ;
	rdfs:subClassOf _:c14n111 , _:c14n112 , _:c14n122 , _:c14n241 , _:c14n305 , _:c14n362 , _:c14n402 , _:c14n431 , _:c14n531 , _:c14n73 , _:c14n75 , _:c14n9 ;
	skos:definition "The template a build environment is instantiated from, such as a VM or container image: root filesystem, guest OS and packages, build executor and build agent." ;
	skos:inScheme slsa:slsa_build_environment ;
	skos:note "The Build Environment track is a working draft and not part of the SLSA v1.2 release." .
slsa:SlsaBuildImageProducer a owl:Class ;
	rdfs:label "SlsaBuildImageProducer" ;
	rdfs:seeAlso <https://slsa.dev/spec/draft/build-env-track-basics#build-environment-model> ;
	rdfs:subClassOf slsa:SlsaParty ;
	skos:definition "The party that creates and distributes build images; the hosted build platform itself, or a third party in a bring-your-own-image setting." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:SlsaBuildLevel\#SLSA_BUILD_LEVEL_0 a owl:Class ;
	rdfs:label "SLSA_BUILD_LEVEL_0" ;
	rdfs:subClassOf slsa:SlsaBuildLevel ;
	skos:definition "No requirements; the absence of SLSA, as for development or test builds." .
slsa:SlsaBuildLevel\#SLSA_BUILD_LEVEL_1 a owl:Class ;
	rdfs:label "SLSA_BUILD_LEVEL_1" ;
	rdfs:subClassOf slsa:SlsaBuildLevel ;
	skos:definition "Provenance exists and shows how the package was built; it prevents mistakes but is easy to forge." .
slsa:SlsaBuildLevel\#SLSA_BUILD_LEVEL_2 a owl:Class ;
	rdfs:label "SLSA_BUILD_LEVEL_2" ;
	rdfs:subClassOf slsa:SlsaBuildLevel ;
	skos:definition "A hosted platform generates and signs the provenance, so tampering after the build needs an explicit attack." ;
	skos:note "Keeping the provenance generator, the verifier and signing tools such as cosign working in CI workflows was a common difficulty (Tamanna et al., 2024, CI.2)." .
slsa:SlsaBuildLevel\#SLSA_BUILD_LEVEL_3 a owl:Class ;
	rdfs:label "SLSA_BUILD_LEVEL_3" ;
	rdfs:subClassOf slsa:SlsaBuildLevel ;
	skos:definition "A hardened platform prevents runs from influencing one another and keeps signing material away from build steps, so forging provenance needs an exploit." ;
	skos:note "Practitioners reported difficulty in generating provenance for the higher levels (Tamanna et al., 2024, CI.1)." .
slsa:SlsaBuildLevel a owl:Class ;
	rdfs:label "SlsaBuildLevel" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/build-track-basics> ;
	owl:unionOf _:c14n175 ;
	skos:definition "The levels of the SLSA Build track, each adding protection against tampering with the build or its provenance." ;
	skos:inScheme slsa:slsa_core ;
	linkml:permissible_values slsa:SlsaBuildLevel\#SLSA_BUILD_LEVEL_0 , slsa:SlsaBuildLevel\#SLSA_BUILD_LEVEL_1 , slsa:SlsaBuildLevel\#SLSA_BUILD_LEVEL_2 , slsa:SlsaBuildLevel\#SLSA_BUILD_LEVEL_3 .
slsa:SlsaBuildMetadata a owl:Class ;
	rdfs:label "SlsaBuildMetadata" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/build-provenance#buildmetadata> ;
	rdfs:subClassOf _:c14n13 , _:c14n226 , _:c14n381 , _:c14n408 , _:c14n428 , _:c14n542 , _:c14n545 , _:c14n92 , _:c14n96 ;
	skos:definition "Metadata about one execution of a build: its identifier and when it started and finished." ;
	skos:inScheme slsa:slsa_build .
slsa:SlsaBuildParameter a owl:Class ;
	rdfs:label "SlsaBuildParameter" ;
	rdfs:subClassOf _:c14n152 , _:c14n170 , _:c14n181 , _:c14n327 , _:c14n342 , _:c14n536 ;
	skos:definition "One named input to a build, with a string value." ;
	skos:inScheme slsa:slsa_build ;
	skos:note "Each name appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." , "The specification recommends string values; a structured value is written as its JSON text." .
slsa:SlsaBuildPlatform a owl:Class ;
	rdfs:label "SlsaBuildPlatform" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/build-provenance#builder> , <https://slsa.dev/spec/v1.2/terminology#build-model> ;
	rdfs:subClassOf _:c14n0 , _:c14n156 , _:c14n204 , _:c14n222 , _:c14n289 , _:c14n30 , _:c14n319 , _:c14n350 , _:c14n374 , _:c14n411 , _:c14n465 , _:c14n64 , _:c14n88 ;
	skos:definition "The system that runs builds and records their provenance: the transitive closure of software, hardware, people and organizations trusted to do so. Provenance names it as the builder." ;
	skos:inScheme slsa:slsa_core ;
	skos:note "A platform with several modes of operation at different levels has a different builder_id for each." .
slsa:SlsaBuildProvenance a owl:Class ;
	rdfs:label "SlsaBuildProvenance" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/build-provenance#provenance> ;
	rdfs:subClassOf slsa:SlsaPredicate , _:c14n209 , _:c14n372 , _:c14n457 , _:c14n472 , _:c14n50 , _:c14n8 ;
	skos:definition "The predicate that says how a build platform produced a set of artifacts, so that consumers can verify the build met their expectations and others can rebuild it." ;
	skos:inScheme slsa:slsa_build ;
	skos:note "Complicated provenance generation was the challenge with the most issues in the study (Tamanna et al., 2024, CI.1)." , "The statement that carries it has predicate_type https://slsa.dev/provenance/v1." .
slsa:SlsaComponentVersion a owl:Class ;
	rdfs:label "SlsaComponentVersion" ;
	rdfs:subClassOf _:c14n125 , _:c14n187 , _:c14n247 , _:c14n385 , _:c14n403 , _:c14n444 ;
	skos:definition "The version of one named component of a platform." ;
	skos:inScheme slsa:slsa_core ;
	skos:note "Each component appears once in a list, since the attestation's JSON uses its name as a key; the validator does not check this." .
slsa:SlsaConsumer a owl:Class ;
	rdfs:label "SlsaConsumer" ;
	rdfs:subClassOf slsa:SlsaParty ;
	skos:definition "A party that uses software a producer provides, verifying its provenance itself or through a verifier." ;
	skos:inScheme slsa:slsa_core .
slsa:SlsaControlPlane a owl:Class ;
	rdfs:label "SlsaControlPlane" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/terminology#build-model> ;
	rdfs:subClassOf _:c14n27 , _:c14n468 , _:c14n87 ;
	skos:definition "The component of a build platform that orchestrates each build and generates its provenance, outside the tenant's control." ;
	skos:inScheme slsa:slsa_core .
slsa:SlsaDependencyInventory a owl:Class ;
	rdfs:label "SlsaDependencyInventory" ;
	rdfs:seeAlso <https://slsa.dev/spec/draft/dependency-track> ;
	rdfs:subClassOf _:c14n114 , _:c14n296 , _:c14n329 , _:c14n401 , _:c14n499 , _:c14n543 , _:c14n82 , _:c14n86 ;
	skos:definition "The inventory of every third-party build dependency, direct and transitive, of one artifact version." ;
	skos:inScheme slsa:slsa_dependency ;
	skos:note "A build-time SBOM or a lock file with hashes is a common form of the inventory." , "The Dependency track is a working draft and not part of the SLSA v1.2 release." .
slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_0 a owl:Class ;
	rdfs:label "SLSA_DEPENDENCY_LEVEL_0" ;
	rdfs:subClassOf slsa:SlsaDependencyLevel ;
	skos:definition "No Dependency track claims." .
slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_1 a owl:Class ;
	rdfs:label "SLSA_DEPENDENCY_LEVEL_1" ;
	rdfs:subClassOf slsa:SlsaDependencyLevel ;
	skos:definition "An inventory of all build dependencies, direct and transitive, exists." .
slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_2 a owl:Class ;
	rdfs:label "SLSA_DEPENDENCY_LEVEL_2" ;
	rdfs:subClassOf slsa:SlsaDependencyLevel ;
	skos:definition "Every known vulnerability in the dependencies was triaged before release." .
slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_3 a owl:Class ;
	rdfs:label "SLSA_DEPENDENCY_LEVEL_3" ;
	rdfs:subClassOf slsa:SlsaDependencyLevel ;
	skos:definition "Every third-party build dependency is consumed from a location the producer controls." .
slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_4 a owl:Class ;
	rdfs:label "SLSA_DEPENDENCY_LEVEL_4" ;
	rdfs:subClassOf slsa:SlsaDependencyLevel ;
	skos:definition "An ingestion policy keeps compromised upstream dependencies out of the build." .
slsa:SlsaDependencyLevel a owl:Class ;
	rdfs:label "SlsaDependencyLevel" ;
	rdfs:seeAlso <https://slsa.dev/spec/draft/dependency-track#levels> ;
	owl:unionOf _:c14n136 ;
	skos:definition "The levels of the SLSA Dependency track, each reducing the risk third-party dependencies bring." ;
	skos:inScheme slsa:slsa_dependency ;
	linkml:permissible_values slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_0 , slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_1 , slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_2 , slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_3 , slsa:SlsaDependencyLevel\#SLSA_DEPENDENCY_LEVEL_4 .
slsa:SlsaDependencyLevelCount a owl:Class ;
	rdfs:label "SlsaDependencyLevelCount" ;
	rdfs:subClassOf _:c14n189 , _:c14n246 , _:c14n377 , _:c14n450 , _:c14n492 , _:c14n520 ;
	skos:definition "The number of an artifact's transitive dependencies verified at one level, each counted once per track at its highest level." ;
	skos:inScheme slsa:slsa_verification ;
	skos:note "Each level appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." .
slsa:SlsaDocument a owl:Class ;
	rdfs:label "SlsaDocument" ;
	rdfs:subClassOf _:c14n139 , _:c14n140 , _:c14n146 , _:c14n147 , _:c14n169 , _:c14n188 , _:c14n195 , _:c14n198 , _:c14n201 , _:c14n227 , _:c14n264 , _:c14n278 , _:c14n284 , _:c14n322 , _:c14n325 , _:c14n349 , _:c14n364 , _:c14n366 , _:c14n367 , _:c14n448 , _:c14n458 , _:c14n466 , _:c14n480 , _:c14n511 , _:c14n512 , _:c14n65 , _:c14n71 ;
	skos:definition "A document that holds SLSA attestations and the parties, platforms, packages, repositories and images they concern." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:SlsaInfrastructureProvider a owl:Class ;
	rdfs:label "SlsaInfrastructureProvider" ;
	rdfs:subClassOf slsa:SlsaParty ;
	skos:definition "A party that provides software or services to the other roles, such as a package registry's or a build platform's maintainers." ;
	skos:inScheme slsa:slsa_core .
slsa:SlsaMeasurement a owl:Class ;
	rdfs:label "SlsaMeasurement" ;
	rdfs:seeAlso <https://slsa.dev/spec/draft/build-env-track-basics#build-environment-model> ;
	rdfs:subClassOf _:c14n119 , _:c14n299 , _:c14n371 , _:c14n423 , _:c14n429 , _:c14n470 ;
	skos:definition "The digest of one component or state of a build environment, to compare with its reference value." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:SlsaNamedReference a owl:Class ;
	rdfs:label "SlsaNamedReference" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/source-requirements#definitions> ;
	rdfs:subClassOf _:c14n143 , _:c14n205 , _:c14n207 , _:c14n221 , _:c14n239 , _:c14n275 , _:c14n285 , _:c14n3 , _:c14n323 , _:c14n332 , _:c14n336 , _:c14n378 , _:c14n427 , _:c14n494 , _:c14n506 ;
	skos:definition "A user-friendly name for a revision in a repository, such as main or v1.2.3; reference_type says whether it is a branch or a tag." ;
	skos:inScheme slsa:slsa_source .
slsa:SlsaPackage a owl:Class ;
	rdfs:label "SlsaPackage" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/terminology#distribution-model> ;
	rdfs:subClassOf _:c14n10 , _:c14n11 , _:c14n160 , _:c14n19 , _:c14n220 , _:c14n286 , _:c14n291 , _:c14n341 , _:c14n358 , _:c14n41 , _:c14n422 , _:c14n424 , _:c14n462 , _:c14n503 , _:c14n507 , _:c14n541 , _:c14n67 ;
	skos:definition "A unit of software distributed under a package name, which is the primary security boundary SLSA protects. Its artifacts are the outputs of builds." ;
	skos:inScheme slsa:slsa_core .
slsa:SlsaPackageRegistry a owl:Class ;
	rdfs:label "SlsaPackageRegistry" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/terminology#distribution-model> ;
	rdfs:subClassOf _:c14n134 , _:c14n151 , _:c14n21 , _:c14n316 , _:c14n529 , _:c14n68 ;
	skos:definition "A distribution platform that resolves package names to immutable package artifacts within an ecosystem." ;
	skos:inScheme slsa:slsa_core .
slsa:SlsaParty a owl:Class ;
	rdfs:label "SlsaParty" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/terminology#roles> ;
	rdfs:subClassOf _:c14n173 , _:c14n272 , _:c14n303 , _:c14n363 , _:c14n383 , _:c14n394 , _:c14n497 ;
	skos:definition "A person or organization that takes part in a software supply chain, in one of the roles SLSA names." ;
	skos:inScheme slsa:slsa_core ;
	skos:note "One party may act in several roles, and several parties may share one role." .
slsa:SlsaPredicate a owl:Class ;
	rdfs:label "SlsaPredicate" ;
	rdfs:subClassOf <https://w3id.org/lmodel/in-toto/InTotoPredicate> , _:c14n193 ;
	skos:definition "The base of every predicate this schema models; the predicate_kind it takes from InTotoPredicate names the concrete kind." ;
	skos:inScheme slsa:slsa_core .
slsa:SlsaProducer a owl:Class ;
	rdfs:label "SlsaProducer" ;
	rdfs:subClassOf slsa:SlsaParty , _:c14n142 , _:c14n330 , _:c14n406 ;
	skos:definition "A party that creates software and provides it to others, choosing a build platform and distributing provenance." ;
	skos:inScheme slsa:slsa_core .
slsa:SlsaResult\#FAILED a owl:Class ;
	rdfs:label "FAILED" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "Policy evaluation failed." .
slsa:SlsaResult\#SLSA_BUILD_LEVEL_0 a owl:Class ;
	rdfs:label "SLSA_BUILD_LEVEL_0" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "No Build track guarantees were verified." .
slsa:SlsaResult\#SLSA_BUILD_LEVEL_1 a owl:Class ;
	rdfs:label "SLSA_BUILD_LEVEL_1" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "Build level 1 was verified." .
slsa:SlsaResult\#SLSA_BUILD_LEVEL_2 a owl:Class ;
	rdfs:label "SLSA_BUILD_LEVEL_2" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "Build level 2 was verified." .
slsa:SlsaResult\#SLSA_BUILD_LEVEL_3 a owl:Class ;
	rdfs:label "SLSA_BUILD_LEVEL_3" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "Build level 3 was verified." .
slsa:SlsaResult\#SLSA_BUILD_LEVEL_UNEVALUATED a owl:Class ;
	rdfs:label "SLSA_BUILD_LEVEL_UNEVALUATED" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "The issuer makes no claim about the Build track level." .
slsa:SlsaResult\#SLSA_BUILD_REPRODUCED a owl:Class ;
	rdfs:label "SLSA_BUILD_REPRODUCED" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "The verified property that two or more independent build platforms reproduced the artifact." .
slsa:SlsaResult\#SLSA_SOURCE_LEVEL_0 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_0" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "No Source track guarantees were verified." .
slsa:SlsaResult\#SLSA_SOURCE_LEVEL_1 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_1" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "Source level 1 was verified." .
slsa:SlsaResult\#SLSA_SOURCE_LEVEL_2 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_2" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "Source level 2 was verified." .
slsa:SlsaResult\#SLSA_SOURCE_LEVEL_3 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_3" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "Source level 3 was verified." .
slsa:SlsaResult\#SLSA_SOURCE_LEVEL_4 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_4" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "Source level 4 was verified." .
slsa:SlsaResult\#SLSA_SOURCE_LEVEL_UNEVALUATED a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_UNEVALUATED" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "The issuer makes no claim about the Source track level." .
slsa:SlsaResult\#SLSA_SOURCE_TWO_PARTY_REVIEWED a owl:Class ;
	rdfs:label "SLSA_SOURCE_TWO_PARTY_REVIEWED" ;
	rdfs:subClassOf slsa:SlsaResult ;
	skos:definition "The verified property that two trusted persons reviewed the source, at whatever source level." .
slsa:SlsaResult a owl:Class ;
	rdfs:label "SlsaResult" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/verification_summary#slsaresult> , <https://slsa.dev/spec/v1.2/verified-properties> ;
	owl:unionOf _:c14n14 ;
	skos:definition "A result of evaluating an artifact against SLSA: a track level, a verified property, or a failure. A level implies the levels below it in the same track." ;
	skos:inScheme slsa:slsa_verification ;
	skos:note "Issuers may add values of their own, but none that start with SLSA_; this enum lists the SLSA-defined values, and slsa_result_value, which verified_levels takes, admits both." , "The working-draft Dependency and Build Environment tracks name no results yet, so none are listed for them." ;
	linkml:permissible_values slsa:SlsaResult\#FAILED , slsa:SlsaResult\#SLSA_BUILD_LEVEL_0 , slsa:SlsaResult\#SLSA_BUILD_LEVEL_1 , slsa:SlsaResult\#SLSA_BUILD_LEVEL_2 , slsa:SlsaResult\#SLSA_BUILD_LEVEL_3 , slsa:SlsaResult\#SLSA_BUILD_LEVEL_UNEVALUATED , slsa:SlsaResult\#SLSA_BUILD_REPRODUCED , slsa:SlsaResult\#SLSA_SOURCE_LEVEL_0 , slsa:SlsaResult\#SLSA_SOURCE_LEVEL_1 , slsa:SlsaResult\#SLSA_SOURCE_LEVEL_2 , slsa:SlsaResult\#SLSA_SOURCE_LEVEL_3 , slsa:SlsaResult\#SLSA_SOURCE_LEVEL_4 , slsa:SlsaResult\#SLSA_SOURCE_LEVEL_UNEVALUATED , slsa:SlsaResult\#SLSA_SOURCE_TWO_PARTY_REVIEWED .
slsa:SlsaResultValue a rdfs:Datatype ;
	owl:equivalentClass _:c14n234 .
slsa:SlsaReviewType\#AUTOMATED a owl:Class ;
	rdfs:label "AUTOMATED" ;
	rdfs:subClassOf slsa:SlsaReviewType ;
	skos:definition "A tool or bot reviewed the change with no second person, which is not two-party review." ;
	skos:note "At Source L4 an organization may still exempt a trusted robot's own changes from two-party review." .
slsa:SlsaReviewType\#MOB_PROGRAMMING a owl:Class ;
	rdfs:label "MOB_PROGRAMMING" ;
	rdfs:subClassOf slsa:SlsaReviewType ;
	skos:definition "A group wrote the change together; whether this counts as two-party review is open." .
slsa:SlsaReviewType\#PAIR_PROGRAMMING a owl:Class ;
	rdfs:label "PAIR_PROGRAMMING" ;
	rdfs:subClassOf slsa:SlsaReviewType ;
	skos:definition "Two developers wrote the change together at one workstation or screen; whether this counts as two-party review is open." .
slsa:SlsaReviewType\#TWO_PARTY a owl:Class ;
	rdfs:label "TWO_PARTY" ;
	rdfs:subClassOf slsa:SlsaReviewType ;
	skos:definition "A reviewer distinct from the author approved the change, both being trusted persons." .
slsa:SlsaReviewType a owl:Class ;
	rdfs:label "SlsaReviewType" ;
	rdfs:seeAlso <https://arxiv.org/abs/2409.05014> ;
	owl:unionOf _:c14n126 ;
	skos:definition "The forms of review that may approve a revision, including the contested forms the adoption study records." ;
	skos:inScheme slsa:slsa_source ;
	linkml:permissible_values slsa:SlsaReviewType\#AUTOMATED , slsa:SlsaReviewType\#MOB_PROGRAMMING , slsa:SlsaReviewType\#PAIR_PROGRAMMING , slsa:SlsaReviewType\#TWO_PARTY ;
	slsa:study_theme "LF.2" .
slsa:SlsaRunDetails a owl:Class ;
	rdfs:label "SlsaRunDetails" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/build-provenance#rundetails> ;
	rdfs:subClassOf _:c14n135 , _:c14n177 , _:c14n203 , _:c14n257 , _:c14n280 , _:c14n29 , _:c14n485 , _:c14n518 ;
	skos:definition "What is specific to one execution of a build: the platform that ran it, metadata about the run and its by-products." ;
	skos:inScheme slsa:slsa_build .
slsa:SlsaSourceControlSystem a owl:Class ;
	rdfs:label "SlsaSourceControlSystem" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/source-requirements#definitions> ;
	rdfs:subClassOf _:c14n277 , _:c14n409 , _:c14n51 ;
	skos:definition "The platform or services that host a source repository and enforce its organization's policies on authentication, authorization and change management." ;
	skos:inScheme slsa:slsa_source ;
	skos:note "The SCS issues the Source VSAs and source provenance for the revisions it hosts." .
slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_0 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_0" ;
	rdfs:subClassOf slsa:SlsaSourceLevel ;
	skos:definition "No Source track guarantees; a revision for which the SCS issues no Source VSA is at this level." .
slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_1 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_1" ;
	rdfs:subClassOf slsa:SlsaSourceLevel ;
	skos:definition "The source is managed in a version control system, so it has discrete, immutable revisions." .
slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_2 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_2" ;
	rdfs:subClassOf slsa:SlsaSourceLevel ;
	skos:definition "Branch history is continuous and retained, and the SCS issues source provenance for each new revision." .
slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_3 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_3" ;
	rdfs:subClassOf slsa:SlsaSourceLevel ;
	skos:definition "The SCS enforces the organization's technical controls on protected named references and provides evidence of them." .
slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_4 a owl:Class ;
	rdfs:label "SLSA_SOURCE_LEVEL_4" ;
	rdfs:subClassOf slsa:SlsaSourceLevel ;
	skos:definition "Two trusted persons agree to every change on protected branches." ;
	skos:note "Whether pair or mob programming counts as two-party review is an open question (Tamanna et al., 2024, LF.2)." .
slsa:SlsaSourceLevel a owl:Class ;
	rdfs:label "SlsaSourceLevel" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/source-requirements#basics> ;
	owl:unionOf _:c14n388 ;
	skos:definition "The levels of the SLSA Source track, each adding trust in how a revision was created." ;
	skos:inScheme slsa:slsa_source ;
	linkml:permissible_values slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_0 , slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_1 , slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_2 , slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_3 , slsa:SlsaSourceLevel\#SLSA_SOURCE_LEVEL_4 .
slsa:SlsaSourceProvenance a owl:Class ;
	rdfs:label "SlsaSourceProvenance" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/source-requirements#source-provenance-attestations> ;
	rdfs:subClassOf slsa:SlsaPredicate , _:c14n145 , _:c14n271 , _:c14n35 , _:c14n528 , _:c14n551 ;
	skos:definition "Evidence from an SCS of how a revision came to exist and which technical controls were enforced when it did." ;
	skos:inScheme slsa:slsa_source ;
	skos:note "SLSA leaves the format of source provenance to each SCS and defines no predicate type for it; this class holds what the specification says such provenance conveys." , "Source L2 and above require the SCS to issue it with each new revision." .
slsa:SlsaSourceRepository a owl:Class ;
	rdfs:label "SlsaSourceRepository" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/source-requirements#definitions> ;
	rdfs:subClassOf _:c14n337 , _:c14n396 , _:c14n452 , _:c14n495 , _:c14n534 , _:c14n59 ;
	skos:definition "A self-contained unit that holds a set of files, their revision history and metadata such as branches and tags." ;
	skos:inScheme slsa:slsa_source .
slsa:SlsaSourceRevision a owl:Class ;
	rdfs:label "SlsaSourceRevision" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/source-requirements#definitions> ;
	rdfs:subClassOf _:c14n155 , _:c14n230 , _:c14n245 , _:c14n251 , _:c14n260 , _:c14n308 , _:c14n380 , _:c14n407 , _:c14n425 , _:c14n430 , _:c14n436 , _:c14n443 , _:c14n461 , _:c14n484 , _:c14n489 , _:c14n498 , _:c14n535 , _:c14n546 , _:c14n548 , _:c14n55 ;
	skos:definition "A logically immutable snapshot of a repository's tracked files, with its version-control metadata: author, time and parent revisions." ;
	skos:inScheme slsa:slsa_source ;
	skos:note "A revision id is unique within its repository and may recur in another; a document that holds revisions from several repositories qualifies them." .
slsa:SlsaStatement a owl:Class ;
	rdfs:label "SlsaStatement" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/attestation-model> , <https://slsa.dev/spec/v1.2/distributing-provenance> ;
	rdfs:subClassOf <https://w3id.org/lmodel/in-toto/InTotoStatement> , _:c14n120 , _:c14n149 , _:c14n183 , _:c14n262 , _:c14n415 , _:c14n464 , _:c14n515 , _:c14n60 , _:c14n94 ;
	skos:definition "An in-toto statement with the fields this schema adds: where the signed attestation is stored, the tool that signed it and the transparency log entry that records the signature." ;
	skos:inScheme slsa:slsa_core ;
	skos:note "Attestation and provenance are often confused; a statement is the attestation, and build provenance is one kind of predicate it may carry (Tamanna et al., 2024, UC.1)." , "InTotoStatement comes from lmodel/in-toto and holds only what the in-toto specification defines, so the fields SLSA's adoption study and the Secure Software Factory add live on this subclass. A statement without them is a valid SlsaStatement too." .
slsa:SlsaTag a owl:Class ;
	rdfs:label "SlsaTag" ;
	rdfs:subClassOf slsa:SlsaNamedReference ;
	skos:definition "A named reference meant never to move once created." ;
	skos:inScheme slsa:slsa_source ;
	skos:note "A version-control tag that is allowed to move, such as latest, is a named reference and not a tag in this sense." .
slsa:SlsaVerificationResult\#FAILED a owl:Class ;
	rdfs:label "FAILED" ;
	rdfs:subClassOf slsa:SlsaVerificationResult ;
	skos:definition "The artifact did not meet the policy." .
slsa:SlsaVerificationResult\#PASSED a owl:Class ;
	rdfs:label "PASSED" ;
	rdfs:subClassOf slsa:SlsaVerificationResult ;
	skos:definition "The artifact met the policy." .
slsa:SlsaVerificationResult a owl:Class ;
	rdfs:label "SlsaVerificationResult" ;
	owl:unionOf _:c14n445 ;
	skos:definition "The outcome of verifying an artifact against a policy." ;
	skos:inScheme slsa:slsa_verification ;
	linkml:permissible_values slsa:SlsaVerificationResult\#FAILED , slsa:SlsaVerificationResult\#PASSED .
slsa:SlsaVerificationSummary a owl:Class ;
	rdfs:label "SlsaVerificationSummary" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/source-requirements#source-verification-summary-attestation> , <https://slsa.dev/spec/v1.2/verification_summary> ;
	rdfs:subClassOf slsa:SlsaPredicate , _:c14n1 , _:c14n118 , _:c14n123 , _:c14n127 , _:c14n148 , _:c14n184 , _:c14n194 , _:c14n224 , _:c14n256 , _:c14n269 , _:c14n288 , _:c14n31 , _:c14n310 , _:c14n313 , _:c14n375 , _:c14n4 , _:c14n404 , _:c14n426 , _:c14n435 , _:c14n475 , _:c14n48 , _:c14n526 , _:c14n539 , _:c14n62 , _:c14n78 , _:c14n85 ;
	skos:definition "The predicate in which a verifier records that it evaluated artifacts against a policy and the SLSA levels they met, so consumers can rely on the verifier instead of reading every underlying attestation." ;
	skos:inScheme slsa:slsa_verification ;
	skos:note "A Source VSA is this predicate with the repository as resource_uri and the revision id in the subject's digest." , "The statement that carries it has predicate_type https://slsa.dev/verification_summary/v1." , "Verification tooling and the places attestations are stored were an adoption difficulty practitioners reported (Tamanna et al., 2024, LF.1)." .
slsa:SlsaVerificationSummaryInputAttestation a owl:Class ;
	rdfs:label "SlsaVerificationSummaryInputAttestation" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/verification_summary#inputAttestations> ;
	rdfs:subClassOf <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> , _:c14n116 , _:c14n150 , _:c14n231 , _:c14n232 , _:c14n253 , _:c14n340 ;
	skos:definition "One attestation a verifier consulted: a resource descriptor that carries the attestation's digest." ;
	skos:inScheme slsa:slsa_verification .
slsa:SlsaVerificationSummaryPolicy a owl:Class ;
	rdfs:label "SlsaVerificationSummaryPolicy" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/verification_summary#policy> ;
	rdfs:subClassOf <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> , _:c14n228 , _:c14n259 , _:c14n293 , _:c14n463 , _:c14n500 , _:c14n525 ;
	skos:definition "The policy a verification summary applied: a resource descriptor that names the policy by URI." ;
	skos:inScheme slsa:slsa_verification ;
	skos:note "A digest is recommended as well, to pin the exact version of the policy." .
slsa:SlsaVerifier a owl:Class ;
	rdfs:label "SlsaVerifier" ;
	rdfs:seeAlso <https://slsa.dev/spec/v1.2/verification_summary#verifier> ;
	rdfs:subClassOf slsa:SlsaParty , _:c14n216 , _:c14n238 , _:c14n318 , _:c14n413 , _:c14n91 ;
	skos:definition "A party that inspects provenance or other attestations and decides whether an artifact is authentic." ;
	skos:inScheme slsa:slsa_core ;
	skos:note "Consumers accept only specific signer and verifier pairs." .
slsa:adoption_metadata a owl:ObjectProperty ;
	rdfs:label "adoption_metadata" ;
	skos:definition "How the deployment the document describes fares against the adoption study's themes." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:artifact a owl:ObjectProperty ;
	rdfs:label "artifact" ;
	skos:definition "The artifact whose dependencies are inventoried." ;
	skos:inScheme slsa:slsa_dependency .
slsa:attestation_storage_uri a owl:DatatypeProperty ;
	rdfs:label "attestation_storage_uri" ;
	skos:definition "Where the signed attestation is stored or can be fetched." ;
	skos:inScheme slsa:slsa_core ;
	skos:note "SLSA asks producers to publish attestations in at least one place and preferably more: beside the source repository's releases, beside the artifact in its package registry, which it prefers in the long term, or elsewhere with an entry in a transparency log." , "Where to store attestations was an open question for practitioners (Tamanna et al., 2024, LF.1)." .
slsa:attestations a owl:ObjectProperty ;
	rdfs:label "attestations" ;
	skos:definition "The attestations, as in-toto statements with SLSA's fields." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:authored_at a owl:DatatypeProperty ;
	rdfs:label "authored_at" ;
	skos:definition "When the revision was created." ;
	skos:inScheme slsa:slsa_source .
slsa:authored_by a owl:DatatypeProperty ;
	rdfs:label "authored_by" ;
	skos:definition "The identity of the person or automation that authored the revision." ;
	skos:inScheme slsa:slsa_source .
slsa:build_definition a owl:ObjectProperty ;
	rdfs:label "build_definition" ;
	skos:definition "The inputs to the build; required at Build L1." ;
	skos:inScheme slsa:slsa_build .
slsa:build_env_level a owl:ObjectProperty ;
	rdfs:label "build_env_level" ;
	rdfs:range slsa:SlsaBuildEnvironmentLevel ;
	skos:definition "The SLSA Build Environment level this meets." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:build_id a owl:DatatypeProperty ;
	rdfs:label "build_id" ;
	skos:definition "The immutable identifier of the build execution the environment was assigned to." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:build_image a owl:ObjectProperty ;
	rdfs:label "build_image" ;
	skos:definition "The image the environment was instantiated from." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:build_images a owl:ObjectProperty ;
	rdfs:label "build_images" ;
	skos:definition "The build images." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:build_level a owl:ObjectProperty ;
	rdfs:label "build_level" ;
	skos:definition "The highest SLSA Build level the platform's provenance can meet." ;
	skos:inScheme slsa:slsa_core .
slsa:build_metadata a owl:ObjectProperty ;
	rdfs:label "build_metadata" ;
	skos:definition "Metadata about this execution of the build." ;
	skos:inScheme slsa:slsa_build .
slsa:build_platform a owl:ObjectProperty ;
	rdfs:label "build_platform" ;
	rdfs:range slsa:SlsaBuildPlatform ;
	skos:definition "The build platform this party or component belongs to or uses." ;
	skos:inScheme slsa:slsa_core .
slsa:build_platforms a owl:ObjectProperty ;
	rdfs:label "build_platforms" ;
	skos:definition "The build platforms." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:build_type a owl:DatatypeProperty ;
	rdfs:label "build_type" ;
	skos:definition "The URI of the template that says how to run the build and read its parameters and dependencies; required at Build L1." ;
	skos:inScheme slsa:slsa_build .
slsa:builder a owl:ObjectProperty ;
	rdfs:label "builder" ;
	skos:definition "The build platform that ran the build and is trusted to have written this provenance; required at Build L1." ;
	skos:inScheme slsa:slsa_build .
slsa:builder_dependencies a owl:ObjectProperty ;
	rdfs:label "builder_dependencies" ;
	skos:definition "Dependencies of the platform's orchestrator that do not run inside the build but may affect provenance generation or its guarantees." ;
	skos:inScheme slsa:slsa_core .
slsa:builder_id a owl:DatatypeProperty ;
	rdfs:label "builder_id" ;
	skos:definition "The URI that identifies the platform and determines its SLSA Build level." ;
	skos:inScheme slsa:slsa_core .
slsa:byproducts a owl:ObjectProperty ;
	rdfs:label "byproducts" ;
	skos:definition "Artifacts the build produced beside its outputs that may help debugging or incident response, such as logs." ;
	skos:inScheme slsa:slsa_build .
slsa:challenges a owl:ObjectProperty ;
	rdfs:label "challenges" ;
	skos:definition "The challenge themes that apply." ;
	skos:inScheme slsa:slsa_adoption .
slsa:component a owl:DatatypeProperty ;
	rdfs:label "component" ;
	skos:definition "The component's name." ;
	skos:inScheme slsa:slsa_core .
slsa:component_version a owl:DatatypeProperty ;
	rdfs:label "component_version" ;
	skos:definition "The component's version string." ;
	skos:inScheme slsa:slsa_core .
slsa:component_versions a owl:ObjectProperty ;
	rdfs:label "component_versions" ;
	rdfs:range slsa:SlsaComponentVersion ;
	skos:definition "The version of each named component of a platform." ;
	skos:inScheme slsa:slsa_core .
slsa:control_planes a owl:ObjectProperty ;
	rdfs:label "control_planes" ;
	skos:definition "The control planes of the build platforms." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:controls_enforced a owl:DatatypeProperty ;
	rdfs:label "controls_enforced" ;
	skos:definition "The technical controls the SCS enforced when the revision was created, as the organization documents them." ;
	skos:inScheme slsa:slsa_source ;
	skos:note "Two-party review is a control many single-maintainer projects cannot meet (Tamanna et al., 2024, LF.2)." .
slsa:dependencies a owl:ObjectProperty ;
	rdfs:label "dependencies" ;
	skos:definition "The dependencies, each as a resource descriptor." ;
	skos:inScheme slsa:slsa_dependency .
slsa:dependency_count a owl:DatatypeProperty ;
	rdfs:label "dependency_count" ;
	skos:definition "How many dependencies were verified at that level." ;
	skos:inScheme slsa:slsa_verification .
slsa:dependency_inventories a owl:ObjectProperty ;
	rdfs:label "dependency_inventories" ;
	skos:definition "The dependency inventories." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:dependency_level a owl:ObjectProperty ;
	rdfs:label "dependency_level" ;
	skos:definition "The SLSA Dependency level the producer's process meets for this artifact." ;
	skos:inScheme slsa:slsa_dependency .
slsa:dependency_levels a owl:ObjectProperty ;
	rdfs:label "dependency_levels" ;
	skos:definition "How many transitive dependencies were verified at each level; absent when the verifier makes no claim about dependencies." ;
	skos:inScheme slsa:slsa_verification ;
	skos:note "The attestation's JSON tells an empty map (no dependencies) from an absent one (no claim); this list cannot, so an empty list reads as no claim." .
slsa:ecosystem a owl:DatatypeProperty ;
	rdfs:label "ecosystem" ;
	skos:definition "The package ecosystem whose rules govern how a package is named and distributed, such as PyPA, npm or OCI." ;
	skos:inScheme slsa:slsa_core ;
	skos:note "One ecosystem's tools can name the same package differently, which the study found affects attestations and provenance, so verifiers match provenance to package names with care (Tamanna et al., 2024, UR.1)." .
slsa:external_parameters a owl:ObjectProperty ;
	rdfs:label "external_parameters" ;
	skos:definition "The inputs under the tenant's control; required at Build L1, complete at Build L3 and verified by consumers." ;
	skos:inScheme slsa:slsa_build ;
	skos:note "Verifiers reject parameters they do not recognize here." .
slsa:finished_on a owl:DatatypeProperty ;
	rdfs:label "finished_on" ;
	skos:definition "When the build finished." ;
	skos:inScheme slsa:slsa_build .
slsa:guac_uri a owl:DatatypeProperty ;
	rdfs:label "guac_uri" ;
	skos:definition "Where a GUAC instance answers queries about the package's dependency and provenance graph." ;
	skos:inScheme slsa:slsa_core .
slsa:hermetic a owl:DatatypeProperty ;
	rdfs:label "hermetic" ;
	skos:definition "Whether the build could reach only the dependencies it declared, with no other network or filesystem access." ;
	skos:inScheme slsa:slsa_build ;
	skos:note "SLSA v1.2 does not require hermetic builds; Build L3's isolation is a different property, and hermeticity is a candidate for a future Build L4." , "The study cites a 2023 industry survey in which over half the participants found hermetic builds hard to implement, and lists \"hermetic build\" among SLSA's unclear terms (Tamanna et al., 2024, UC.1)." .
slsa:hosted a owl:DatatypeProperty ;
	rdfs:label "hosted" ;
	skos:definition "Whether the platform is a hosted service on shared or dedicated infrastructure rather than an individual's workstation." ;
	skos:inScheme slsa:slsa_core ;
	skos:note "Build L2 and above require a hosted platform." .
slsa:hosted_by a owl:ObjectProperty ;
	rdfs:label "hosted_by" ;
	skos:definition "The source control system that hosts the repository." ;
	skos:inScheme slsa:slsa_source .
slsa:image_uri a owl:DatatypeProperty ;
	rdfs:label "image_uri" ;
	skos:definition "The URI that identifies the image version, such as an OCI reference with its digest." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:input_attestations a owl:ObjectProperty ;
	rdfs:label "input_attestations" ;
	skos:definition "Every attestation the verifier consulted, each with a digest; complete when present." ;
	skos:inScheme slsa:slsa_verification .
slsa:internal_parameters a owl:ObjectProperty ;
	rdfs:label "internal_parameters" ;
	skos:definition "The inputs the platform sets itself; kept for debugging, incident response and reproduction, and not verified by consumers." ;
	skos:inScheme slsa:slsa_build .
slsa:invocation_id a owl:DatatypeProperty ;
	rdfs:label "invocation_id" ;
	skos:definition "An identifier for this build invocation, in a format the builder defines; useful for finding its logs." ;
	skos:inScheme slsa:slsa_build .
slsa:measured_component a owl:DatatypeProperty ;
	rdfs:label "measured_component" ;
	skos:definition "The component or state that was measured, such as the bootloader, guest kernel, build agent or root filesystem." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:measurements a owl:ObjectProperty ;
	rdfs:label "measurements" ;
	skos:definition "The measurements of the environment's components taken during boot." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:named_references a owl:ObjectProperty ;
	rdfs:label "named_references" ;
	skos:definition "The branches and tags." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:organization_properties a owl:DatatypeProperty ;
	rdfs:label "organization_properties" ;
	skos:definition "Properties the organization defines for the revision, each prefixed ORG_SOURCE_; ORG_SOURCE_INTERNAL_ marks one not meant for external consumers." ;
	skos:inScheme slsa:slsa_verification .
slsa:package_artifacts a owl:ObjectProperty ;
	rdfs:label "package_artifacts" ;
	skos:definition "The immutable artifacts the package name has resolved to." ;
	skos:inScheme slsa:slsa_core .
slsa:package_name a owl:DatatypeProperty ;
	rdfs:label "package_name" ;
	skos:definition "The name consumers use to obtain the package within its ecosystem and registry." ;
	skos:inScheme slsa:slsa_core .
slsa:package_registries a owl:ObjectProperty ;
	rdfs:label "package_registries" ;
	skos:definition "The package registries." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:packages a owl:ObjectProperty ;
	rdfs:label "packages" ;
	skos:definition "The packages." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:parameter_name a owl:DatatypeProperty ;
	rdfs:label "parameter_name" ;
	skos:definition "The parameter's name." ;
	skos:inScheme slsa:slsa_build .
slsa:parameter_value a owl:DatatypeProperty ;
	rdfs:label "parameter_value" ;
	skos:definition "The parameter's value." ;
	skos:inScheme slsa:slsa_build .
slsa:parent_revisions a owl:ObjectProperty ;
	rdfs:label "parent_revisions" ;
	skos:definition "The revisions this one descends from, which together form the change history." ;
	skos:inScheme slsa:slsa_source .
slsa:parties a owl:ObjectProperty ;
	rdfs:label "parties" ;
	skos:definition "The parties, each in its role." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:party_name a owl:DatatypeProperty ;
	rdfs:label "party_name" ;
	skos:definition "The party's name." ;
	skos:inScheme slsa:slsa_core .
slsa:party_type a owl:DatatypeProperty ;
	rdfs:label "party_type" ;
	skos:definition "The role the party acts in, one of this class's descendants." ;
	skos:inScheme slsa:slsa_core .
slsa:pipeline_orchestrator a owl:DatatypeProperty ;
	rdfs:label "pipeline_orchestrator" ;
	skos:definition "The CI/CD system that coordinated the build, named by URI, where it differs from the builder." ;
	skos:inScheme slsa:slsa_build ;
	skos:note "In the Secure Software Factory architecture this is the Build Service layer, distinct from the provenance-generating builder." .
slsa:policy a owl:ObjectProperty ;
	rdfs:label "policy" ;
	skos:definition "The policy the subject was verified against, by URI and preferably by digest too." ;
	skos:inScheme slsa:slsa_verification .
slsa:produced_by a owl:ObjectProperty ;
	rdfs:label "produced_by" ;
	skos:definition "The party that created and distributes the image." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:protected a owl:DatatypeProperty ;
	rdfs:label "protected" ;
	skos:definition "Whether the organization has the SCS enforce its technical controls on this reference." ;
	skos:inScheme slsa:slsa_source .
slsa:provenance a owl:ObjectProperty ;
	rdfs:label "provenance" ;
	skos:definition "The build provenance of the image itself, required at Build Environment L1." ;
	skos:inScheme slsa:slsa_build_environment .
slsa:provenance_generation_tool a owl:DatatypeProperty ;
	rdfs:label "provenance_generation_tool" ;
	skos:definition "The tool that generated this provenance, named by URI." ;
	skos:inScheme slsa:slsa_build ;
	skos:note "Naming the generator supports the strategy of standardizing provenance generation (Tamanna et al., 2024, S3.1)." .
slsa:reference_name a owl:DatatypeProperty ;
	rdfs:label "reference_name" ;
	skos:definition "The reference's name, fully qualified in git, such as refs/heads/main." ;
	skos:inScheme slsa:slsa_source .
slsa:reference_type a owl:DatatypeProperty ;
	rdfs:label "reference_type" ;
	skos:definition "The kind of named reference, one of this class's descendants." ;
	skos:inScheme slsa:slsa_source .
slsa:registry a owl:ObjectProperty ;
	rdfs:label "registry" ;
	skos:definition "The registry the package is published to." ;
	skos:inScheme slsa:slsa_core .
slsa:registry_uri a owl:DatatypeProperty ;
	rdfs:label "registry_uri" ;
	skos:definition "The URI that identifies the registry." ;
	skos:inScheme slsa:slsa_core .
slsa:repository a owl:ObjectProperty ;
	rdfs:label "repository" ;
	rdfs:range slsa:SlsaSourceRepository ;
	skos:definition "The source repository this belongs to." ;
	skos:inScheme slsa:slsa_source .
slsa:repository_uri a owl:DatatypeProperty ;
	rdfs:label "repository_uri" ;
	skos:definition "The stable locator the SCS gives the repository." ;
	skos:inScheme slsa:slsa_source .
slsa:resolved_dependencies a owl:ObjectProperty ;
	rdfs:label "resolved_dependencies" ;
	skos:definition "The artifacts fetched during the build, as far as the platform knows them; completeness is best effort through Build L3." ;
	skos:inScheme slsa:slsa_build .
slsa:review_type a owl:ObjectProperty ;
	rdfs:label "review_type" ;
	skos:definition "The form of review that approved the revision." ;
	skos:inScheme slsa:slsa_source .
slsa:revision a owl:ObjectProperty ;
	rdfs:label "revision" ;
	rdfs:range slsa:SlsaSourceRevision ;
	skos:definition "The source revision this refers to." ;
	skos:inScheme slsa:slsa_source .
slsa:revision_id a owl:DatatypeProperty ;
	rdfs:label "revision_id" ;
	skos:definition "The revision identifier the SCS assigns, such as a git commit id or a path- qualified sequence number." ;
	skos:inScheme slsa:slsa_source .
slsa:run_details a owl:ObjectProperty ;
	rdfs:label "run_details" ;
	skos:definition "What is specific to this execution of the build; required at Build L1." ;
	skos:inScheme slsa:slsa_build .
slsa:scs_uri a owl:DatatypeProperty ;
	rdfs:label "scs_uri" ;
	skos:definition "The URI that identifies the source control system." ;
	skos:inScheme slsa:slsa_source .
slsa:security_insights_uri a owl:DatatypeProperty ;
	rdfs:label "security_insights_uri" ;
	skos:definition "The SECURITY-INSIGHTS.yml file of the project that produces the package." ;
	skos:inScheme slsa:slsa_core .
slsa:signing_tool a owl:DatatypeProperty ;
	rdfs:label "signing_tool" ;
	skos:definition "The tool that signed the attestation, named by URI, such as Cosign or Notation." ;
	skos:inScheme slsa:slsa_core .
slsa:slsa_version a owl:DatatypeProperty ;
	rdfs:label "slsa_version" ;
	skos:definition "The SLSA specification version the verifier applied, as MAJOR.MINOR." ;
	skos:inScheme slsa:slsa_verification .
slsa:source_control_systems a owl:ObjectProperty ;
	rdfs:label "source_control_systems" ;
	skos:definition "The source control systems." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:source_level a owl:ObjectProperty ;
	rdfs:label "source_level" ;
	skos:definition "The SLSA Source level the SCS asserts for the revision." ;
	skos:inScheme slsa:slsa_source .
slsa:source_repositories a owl:ObjectProperty ;
	rdfs:label "source_repositories" ;
	skos:definition "The source repositories." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:source_revisions a owl:ObjectProperty ;
	rdfs:label "source_revisions" ;
	skos:definition "The source revisions." ;
	skos:inScheme <https://w3id.org/lmodel/slsa> .
slsa:started_on a owl:DatatypeProperty ;
	rdfs:label "started_on" ;
	skos:definition "When the build started." ;
	skos:inScheme slsa:slsa_build .
slsa:strategies a owl:ObjectProperty ;
	rdfs:label "strategies" ;
	skos:definition "The strategy themes applied or recommended." ;
	skos:inScheme slsa:slsa_adoption .
slsa:time_verified a owl:DatatypeProperty ;
	rdfs:label "time_verified" ;
	skos:definition "When the verification happened." ;
	skos:inScheme slsa:slsa_verification .
slsa:transparency_log_entry a owl:DatatypeProperty ;
	rdfs:label "transparency_log_entry" ;
	skos:definition "The transparency log entry that records the signature, such as a Rekor entry." ;
	skos:inScheme slsa:slsa_core .
slsa:verification_result a owl:ObjectProperty ;
	rdfs:label "verification_result" ;
	skos:definition "Whether the subject passed the policy." ;
	skos:inScheme slsa:slsa_verification .
slsa:verified_level a owl:DatatypeProperty ;
	rdfs:label "verified_level" ;
	skos:definition "The level the dependencies were verified at, or a result of the issuer's own." ;
	skos:inScheme slsa:slsa_verification .
slsa:verified_levels a owl:DatatypeProperty ;
	rdfs:label "verified_levels" ;
	skos:definition "The highest level verified in each track, any verified property, and any result of the issuer's own; a level implies the levels below it." ;
	skos:inScheme slsa:slsa_verification ;
	skos:note "A VSA lists at most one level per track, and only FAILED when verification failed; the validator checks neither." .
slsa:verifier a owl:ObjectProperty ;
	rdfs:label "verifier" ;
	skos:definition "The verifier that made this determination." ;
	skos:inScheme slsa:slsa_verification .
slsa:verifier_id a owl:DatatypeProperty ;
	rdfs:label "verifier_id" ;
	skos:definition "The URI that identifies the verifier." ;
	skos:inScheme slsa:slsa_core .
